+fn coded_scan_preamble_priorities(demod: &[f32], limit: usize) -> Vec<u16> {
+    // Compare the balanced coded pattern against symbol averages with local
+    // mean removed. Hard streaks retain priority in each bounded search region.
+    const MIN_CORRELATION_SQUARED: f64 = 0.65 * 0.65;
+    const PERIOD: usize = CODED_PREAMBLE_PATTERN.len();
+    let mut priorities: Vec<_> = coded_scan_preamble_scores(demod)
+        .into_iter()
+        .take(limit)
+        .map(|streak| if streak >= 5 { 256 + u16::from(streak) } else { 0 })
+        .collect();
+    let count = CODED_PREAMBLE_SYMBOLS as f64;
+    for phase in 0..BLE_SPS {
+        let (symbols, _) = demod[phase..].as_chunks::<BLE_SPS>();
+        let mut sum = Vec::with_capacity(symbols.len() + 1);
+        let mut energy = Vec::with_capacity(symbols.len() + 1);
+        sum.push(0.0);
+        energy.push(0.0);
+        let mut sum_prefix = 0.0;
+        let mut energy_prefix = 0.0;
+        for samples in symbols {
+            let value = samples.iter().map(|&value| f64::from(value)).sum::<f64>()
+                / BLE_SPS as f64;
+            sum_prefix += value;
+            energy_prefix += value * value;
+            sum.push(sum_prefix);
+            energy.push(energy_prefix);
+        }
+        // The middle four symbols of 00111100 carry positive weight. A
+        // one-period shift changes just the first and last correlations.
+        let period_dot = |start: usize| {
+            2.0 * (sum[start + 6] - sum[start + 2]) - (sum[start + PERIOD] - sum[start])
+        };
+        let mut dot = [0.0; PERIOD];
+        for start in 0..limit.saturating_sub(phase).div_ceil(BLE_SPS) {
+            let end = start + CODED_PREAMBLE_SYMBOLS;
+            let period = start % PERIOD;
+            dot[period] = if start < PERIOD {
+                (start..end).step_by(PERIOD).map(period_dot).sum()
+            } else {
+                dot[period] - period_dot(start - PERIOD) + period_dot(end - PERIOD)
+            };
+            let centered_energy = energy[end] - energy[start]
+                - (sum[end] - sum[start]).powi(2) / count;
+            let power = count * centered_energy;
+            let numerator = dot[period] * dot[period];
+            let priority = &mut priorities[phase + start * BLE_SPS];
+            if *priority == 0 && power > 0.0 && numerator >= MIN_CORRELATION_SQUARED * power {
+                *priority = ((numerator / power).min(1.0) * 255.0) as u16;
+            }
+        }
+    }
+    priorities
+}
