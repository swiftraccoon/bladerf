+                    .as_chunks_mut::<{ CODED_PREAMBLE_PATTERN.len() * BLE_SPS }>();
+                for period in periods {
+                    for symbol in [1, 5] {
+                        for value in &mut period[symbol * BLE_SPS..(symbol + 1) * BLE_SPS] {
+                            *value *= -0.05;
+                        }
+                    }
+                }
