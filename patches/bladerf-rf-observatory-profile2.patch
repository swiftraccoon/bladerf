+
+package rf_observatory_p is
+    type phase_steps_t is array (0 to 3) of unsigned(31 downto 0);
+    type iq_words_t is array (0 to 3) of signed(15 downto 0);
+    type sine_table_t is array (0 to 255) of integer range -32767 to 32767;
