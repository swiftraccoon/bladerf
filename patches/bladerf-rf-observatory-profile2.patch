diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2.sdc b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2.sdc
new file mode 100644
index 00000000..b92f8c19
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2.sdc
@@ -0,0 +1,67 @@
+# Profile-2 bundled-control CDC and reset-release constraints.
+#
+# The 160-bit payload is captured in the 80 MHz control domain, held for one
+# complete source cycle before request assertion, and kept stable through the
+# four-phase response. Bound the complete payload path to that 12.5 ns prepare
+# interval. Its destination capture is handshake-qualified rather than
+# edge-related, so ordinary asynchronous-clock hold analysis does not apply.
+
+set profile2_payload_sources [get_registers {
+    *rf_profile2_control_cdc:control_bridge|request_words_control*
+    *rf_profile2_control_cdc:control_bridge|request_epoch_control*
+}]
+set profile2_payload_destinations [get_registers {
+    *rf_profile2_control_cdc:control_bridge|armed_words_rx*
+    *rf_profile2_control_cdc:control_bridge|armed_epoch_rx*
+}]
+
+if {
+    [get_collection_size $profile2_payload_sources] != 160 ||
+    [get_collection_size $profile2_payload_destinations] != 160
+} {
+    error "profile-2 bundled CDC register collection changed"
+}
+
+set_max_delay 12.500 \
+    -from $profile2_payload_sources \
+    -to $profile2_payload_destinations
+set_false_path -hold \
+    -from $profile2_payload_sources \
+    -to $profile2_payload_destinations
+
+# sys_reset_i asynchronously asserts both RX reset-release registers. Their
+# deassertion is intentionally synchronized by the two-register chain, so cut
+# only the asynchronous clear pins; retain normal timing between the registers.
+set profile2_reset_clear_pins [get_pins -compatibility_mode {
+    *rf_profile2_init_reset:U_rf_profile2_init_reset|rx_reset_meta|clrn
+    *rf_profile2_init_reset:U_rf_profile2_init_reset|rx_reset_sync|clrn
+}]
+
+if {[get_collection_size $profile2_reset_clear_pins] != 2} {
+    error "profile-2 reset synchronizer clear-pin collection changed"
+}
+
+set_false_path -to $profile2_reset_clear_pins
+
+# The profile reset is released on the RX/write clock before it reaches the
+# dual-clock sample FIFO.  That FIFO has READ_ACLR_SYNCH enabled, so its two
+# read-side rdaclr registers deliberately receive an asynchronous clear whose
+# release is synchronized internally to the FX3/read clock.  This is the
+# read-side counterpart of the upstream wraclr exception for RX disable.
+set profile2_fifo_reset_source [get_registers {
+    *rf_profile2_init_reset:U_rf_profile2_init_reset|rx_reset_sync
+}]
+set profile2_fifo_read_clear_pins [get_pins -compatibility_mode {
+    *rx_fifo:U_rx_sample_fifo*|dffpipe_*:rdaclr|*|clrn
+}]
+
+if {
+    [get_collection_size $profile2_fifo_reset_source] != 1 ||
+    [get_collection_size $profile2_fifo_read_clear_pins] != 2
+} {
+    error "profile-2 sample-FIFO read-clear collection changed"
+}
+
+set_false_path \
+    -from $profile2_fifo_reset_source \
+    -to $profile2_fifo_read_clear_pins
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_control_cdc.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_control_cdc.vhd
new file mode 100644
index 00000000..0bd7ccc0
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_control_cdc.vhd
@@ -0,0 +1,240 @@
+-- Profile-2 configuration handshake between the Wishbone/system clock and the
+-- AD9361 RX clock. The producer must hold apply_valid until apply_done. This
+-- block captures the 160-bit request payload in the control domain, then holds
+-- that bundled data stable from a full clock before request through response.
+-- A four-phase request/response handshake carries only control levels and the
+-- one-bit result. Keeping the producer busy through return-to-zero prevents a
+-- fast following request from being lost.
+--
+-- control_reset and rx_reset must come from one image-reset event; bounded
+-- assertion/deassertion skew is allowed, but isolated domain reset is not a
+-- recovery protocol. Digital simulation cannot qualify metastability or the
+-- eventual fitted timing constraint on the bundled payload.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+library work;
+use work.rf_observatory_p.all;
+
+entity rf_profile2_control_cdc is
+    port (
+        control_clock : in std_logic;
+        control_reset : in std_logic;
+
+        apply_valid : in std_logic;
+        apply_words : in phase_steps_t;
+        apply_epoch : in unsigned(31 downto 0);
+        apply_done : out std_logic;
+        apply_success : out std_logic;
+        rx_active_sync : out std_logic;
+
+        rx_clock : in std_logic;
+        rx_reset : in std_logic;
+        rx_enable : in std_logic;
+
+        start_pulse : out std_logic;
+        start_authorized : out std_logic;
+        active_valid : out std_logic;
+        active_words : out phase_steps_t;
+        active_epoch : out unsigned(31 downto 0)
+    );
+end entity;
+
+architecture rtl of rf_profile2_control_cdc is
+    type control_state_t is (CONTROL_IDLE, CONTROL_PREPARE_REQUEST,
+        CONTROL_WAIT_RESPONSE, CONTROL_WAIT_RESPONSE_RELEASE,
+        CONTROL_WAIT_VALID_RELEASE);
+    type rx_state_t is (RX_IDLE, RX_CAPTURE, RX_WAIT_REQUEST_RELEASE);
+
+    signal control_state : control_state_t := CONTROL_IDLE;
+    signal request_level : std_logic := '0';
+    signal response_level_rx : std_logic := '0';
+    signal response_level_sync : std_logic := '0';
+    signal response_success_rx : std_logic := '0';
+    signal response_success_sync : std_logic := '0';
+    signal apply_done_i : std_logic := '0';
+    signal apply_success_i : std_logic := '0';
+    signal request_words_control : phase_steps_t := (others => (others => '0'));
+    signal request_epoch_control : unsigned(31 downto 0) := (others => '0');
+
+    signal request_level_sync : std_logic := '0';
+    signal rx_state : rx_state_t := RX_IDLE;
+
+    signal armed_words_rx : phase_steps_t := (others => (others => '0'));
+    signal armed_epoch_rx : unsigned(31 downto 0) := (others => '0');
+    signal token_armed_rx : std_logic := '0';
+    signal previous_rx_enable : std_logic := '0';
+    signal start_pulse_i : std_logic := '0';
+    signal start_authorized_i : std_logic := '0';
+    signal active_valid_i : std_logic := '0';
+    signal active_words_i : phase_steps_t := (others => (others => '0'));
+    signal active_epoch_i : unsigned(31 downto 0) := (others => '0');
+begin
+    apply_done <= apply_done_i;
+    apply_success <= apply_success_i;
+    start_pulse <= start_pulse_i;
+    start_authorized <= start_authorized_i;
+    active_valid <= active_valid_i;
+    active_words <= active_words_i;
+    active_epoch <= active_epoch_i;
+
+    request_level_synchronizer : entity work.synchronizer
+        generic map (RESET_LEVEL => '0')
+        port map (
+            reset => rx_reset,
+            clock => rx_clock,
+            async => request_level,
+            sync => request_level_sync
+        );
+
+    response_level_synchronizer : entity work.synchronizer
+        generic map (RESET_LEVEL => '0')
+        port map (
+            reset => control_reset,
+            clock => control_clock,
+            async => response_level_rx,
+            sync => response_level_sync
+        );
+
+    response_value_sync : entity work.synchronizer
+        generic map (RESET_LEVEL => '0')
+        port map (
+            reset => control_reset,
+            clock => control_clock,
+            async => response_success_rx,
+            sync => response_success_sync
+        );
+
+    rx_active_level_sync : entity work.synchronizer
+        generic map (RESET_LEVEL => '0')
+        port map (
+            reset => control_reset,
+            clock => control_clock,
+            async => rx_enable,
+            sync => rx_active_sync
+        );
+
+    control_handshake : process(control_clock, control_reset)
+    begin
+        if control_reset = '1' then
+            control_state <= CONTROL_IDLE;
+            request_level <= '0';
+            apply_done_i <= '0';
+            apply_success_i <= '0';
+            request_words_control <= (others => (others => '0'));
+            request_epoch_control <= (others => '0');
+        elsif rising_edge(control_clock) then
+            apply_done_i <= '0';
+            case control_state is
+                when CONTROL_IDLE =>
+                    apply_success_i <= '0';
+                    if apply_valid = '1' then
+                        request_words_control <= apply_words;
+                        request_epoch_control <= apply_epoch;
+                        control_state <= CONTROL_PREPARE_REQUEST;
+                    end if;
+
+                when CONTROL_PREPARE_REQUEST =>
+                    -- Give all 160 bundled payload bits one full source clock
+                    -- of stability before the request level can cross domains.
+                    request_level <= '1';
+                    control_state <= CONTROL_WAIT_RESPONSE;
+
+                when CONTROL_WAIT_RESPONSE =>
+                    if response_level_sync = '1' then
+                        request_level <= '0';
+                        control_state <= CONTROL_WAIT_RESPONSE_RELEASE;
+                    end if;
+
+                when CONTROL_WAIT_RESPONSE_RELEASE =>
+                    if response_level_sync = '0' then
+                        -- The separately synchronized result has remained
+                        -- stable through the complete four-phase exchange.
+                        apply_success_i <= response_success_sync;
+                        apply_done_i <= '1';
+                        control_state <= CONTROL_WAIT_VALID_RELEASE;
+                    end if;
+
+                when CONTROL_WAIT_VALID_RELEASE =>
+                    -- The register samples apply_done one clock after this block
+                    -- raises it. Do not reinterpret its still-high apply_valid as
+                    -- another request while that level is being released.
+                    if apply_valid = '0' then
+                        apply_success_i <= '0';
+                        control_state <= CONTROL_IDLE;
+                    end if;
+            end case;
+        end if;
+    end process;
+
+    rx_handshake_and_start : process(rx_clock, rx_reset)
+    begin
+        if rx_reset = '1' then
+            rx_state <= RX_IDLE;
+            response_level_rx <= '0';
+            response_success_rx <= '0';
+            armed_words_rx <= (others => (others => '0'));
+            armed_epoch_rx <= (others => '0');
+            token_armed_rx <= '0';
+            previous_rx_enable <= '0';
+            start_pulse_i <= '0';
+            start_authorized_i <= '0';
+            active_valid_i <= '0';
+            active_words_i <= (others => (others => '0'));
+            active_epoch_i <= (others => '0');
+        elsif rising_edge(rx_clock) then
+            start_pulse_i <= '0';
+            start_authorized_i <= '0';
+            previous_rx_enable <= rx_enable;
+
+            if rx_enable = '1' and previous_rx_enable = '0' then
+                start_pulse_i <= '1';
+                if token_armed_rx = '1' then
+                    start_authorized_i <= '1';
+                    active_valid_i <= '1';
+                    active_words_i <= armed_words_rx;
+                    active_epoch_i <= armed_epoch_rx;
+                    token_armed_rx <= '0';
+                else
+                    active_valid_i <= '0';
+                    active_words_i <= (others => (others => '0'));
+                    active_epoch_i <= (others => '0');
+                end if;
+            elsif rx_enable = '0' then
+                active_valid_i <= '0';
+                active_words_i <= (others => (others => '0'));
+                active_epoch_i <= (others => '0');
+            end if;
+
+            case rx_state is
+                when RX_IDLE =>
+                    if request_level_sync = '1' then
+                        rx_state <= RX_CAPTURE;
+                    end if;
+
+                when RX_CAPTURE =>
+                    -- RX-enable wins any same-edge race. While stopped, a new
+                    -- successful apply replaces the one armed configuration;
+                    -- it does not queue a second future start.
+                    if rx_enable = '0' then
+                        armed_words_rx <= request_words_control;
+                        armed_epoch_rx <= request_epoch_control;
+                        token_armed_rx <= '1';
+                        response_success_rx <= '1';
+                    else
+                        response_success_rx <= '0';
+                    end if;
+                    response_level_rx <= '1';
+                    rx_state <= RX_WAIT_REQUEST_RELEASE;
+
+                when RX_WAIT_REQUEST_RELEASE =>
+                    if request_level_sync = '0' then
+                        response_level_rx <= '0';
+                        rx_state <= RX_IDLE;
+                    end if;
+            end case;
+        end if;
+    end process;
+end architecture;
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_framer.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_framer.vhd
new file mode 100644
index 00000000..6555895c
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_framer.vhd
@@ -0,0 +1,308 @@
+-- Profile-2 CONFIG-first channel bank and transport serializer. Every idle-
+-- epoch RX start emits exactly one eight-slot CONFIG record before any sample
+-- is admitted to the numerical bank. An unauthorized or invalid start emits
+-- the diagnostic CONFIG and then remains silent until reset.
+--
+-- Output is a conventional ready/valid stream. While m_valid is asserted and
+-- m_ready is clear, the current slot and every snapshotted record field remain
+-- unchanged. The downstream wrapper must make m_ready mean that the slot will
+-- be retained; serializer completion alone is not FIFO-persistence evidence.
+--
+-- s_ready denotes actual admission to rf_channel_bank. It remains low while
+-- CONFIG is pending and after an invalid start. Physical samples presented in
+-- that deliberate startup interval are discarded without setting input loss.
+-- Once DATA is enabled, an unstallable input presented while s_ready is low sets
+-- sticky loss. Reset discards every partial record and all numerical state; the
+-- integration wrapper must coherently clear its downstream packer/FIFO too.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+library work;
+use work.rf_observatory_p.all;
+
+entity rf_profile2_framer is
+    port (
+        clock : in std_logic;
+        reset : in std_logic;
+
+        start_pulse : in std_logic;
+        start_authorized : in std_logic;
+        active_valid : in std_logic;
+        active_words : in phase_steps_t;
+        active_epoch : in unsigned(31 downto 0);
+
+        s_valid : in std_logic;
+        s_ready : out std_logic;
+        s_i : in signed(15 downto 0);
+        s_q : in signed(15 downto 0);
+        source_rx2 : in std_logic;
+        configuration_error : in std_logic;
+        transport_loss : in std_logic;
+
+        m_valid : out std_logic;
+        m_ready : in std_logic;
+        m_i : out signed(15 downto 0);
+        m_q : out signed(15 downto 0)
+    );
+end entity;
+
+architecture rtl of rf_profile2_framer is
+    constant REQUIRED_SOURCE_RATE : unsigned(31 downto 0) :=
+        to_unsigned(20_000_000, 32);
+
+    type state_t is (
+        WAIT_START,
+        EMIT_CONFIG,
+        DATA_WAIT_GROUP,
+        EMIT_DATA,
+        DIAGNOSTIC_DONE
+    );
+
+    signal state : state_t := WAIT_START;
+    signal slot : natural range 0 to 7 := 0;
+
+    signal epoch_usable : std_logic := '0';
+    signal startup_transport_loss : std_logic := '0';
+    signal epoch_words : phase_steps_t := (others => (others => '0'));
+    signal epoch_number : unsigned(31 downto 0) := (others => '0');
+    signal epoch_source_rx2 : std_logic := '0';
+    signal config_flags : std_logic_vector(15 downto 0) := (others => '0');
+
+    signal loss_sticky : std_logic := '0';
+    signal config_sticky : std_logic := '0';
+
+    signal bank_reset : std_logic;
+    signal bank_s_valid : std_logic;
+    signal bank_s_ready : std_logic;
+    signal bank_m_valid : std_logic;
+    signal bank_m_ready : std_logic;
+    signal bank_i : iq_words_t;
+    signal bank_q : iq_words_t;
+    signal bank_clipped : std_logic_vector(3 downto 0);
+    signal bank_index : unsigned(63 downto 0);
+
+    signal held_i : iq_words_t := (others => (others => '0'));
+    signal held_q : iq_words_t := (others => (others => '0'));
+    signal held_index : unsigned(63 downto 0) := (others => '0');
+    signal held_flags : std_logic_vector(15 downto 0) := (others => '0');
+
+    signal data_phase : std_logic;
+begin
+    data_phase <= '1' when state = DATA_WAIT_GROUP or state = EMIT_DATA else '0';
+    bank_reset <= reset or not data_phase;
+    bank_s_valid <= s_valid when data_phase = '1' else '0';
+    bank_m_ready <= '1' when state = DATA_WAIT_GROUP else '0';
+
+    s_ready <= bank_s_ready when data_phase = '1' and reset = '0' else '0';
+    m_valid <= '1' when (state = EMIT_CONFIG or state = EMIT_DATA)
+        and reset = '0' else '0';
+
+    bank : entity work.rf_channel_bank
+        port map (
+            clock => clock,
+            reset => bank_reset,
+            phase_steps => epoch_words,
+            s_valid => bank_s_valid,
+            s_ready => bank_s_ready,
+            s_i => s_i,
+            s_q => s_q,
+            m_valid => bank_m_valid,
+            m_ready => bank_m_ready,
+            m_i => bank_i,
+            m_q => bank_q,
+            m_clipped => bank_clipped,
+            m_last_input_index => bank_index
+        );
+
+    serialize : process(all)
+    begin
+        m_i <= (others => '0');
+        m_q <= (others => '0');
+
+        if state = EMIT_CONFIG then
+            case slot is
+                when 0 =>
+                    m_i <= signed'(x"5246");
+                    m_q <= signed'(x"4f42");
+                when 1 =>
+                    m_i <= signed(config_flags);
+                    m_q <= to_signed(2, 16);
+                when 2 =>
+                    m_i <= signed(epoch_number(15 downto 0));
+                    m_q <= signed(epoch_number(31 downto 16));
+                when 3 =>
+                    m_i <= signed(REQUIRED_SOURCE_RATE(15 downto 0));
+                    m_q <= signed(REQUIRED_SOURCE_RATE(31 downto 16));
+                when others =>
+                    m_i <= signed(epoch_words(slot - 4)(15 downto 0));
+                    m_q <= signed(epoch_words(slot - 4)(31 downto 16));
+            end case;
+        elsif state = EMIT_DATA then
+            case slot is
+                when 0 =>
+                    m_i <= signed'(x"5246");
+                    m_q <= signed'(x"4f42");
+                when 1 =>
+                    m_i <= signed(held_flags);
+                    m_q <= to_signed(2, 16);
+                when 2 =>
+                    m_i <= signed(held_index(15 downto 0));
+                    m_q <= signed(held_index(31 downto 16));
+                when 3 =>
+                    m_i <= signed(held_index(47 downto 32));
+                    m_q <= signed(held_index(63 downto 48));
+                when others =>
+                    m_i <= held_i(slot - 4);
+                    m_q <= held_q(slot - 4);
+            end case;
+        end if;
+    end process;
+
+    control : process(clock)
+        variable flags : std_logic_vector(15 downto 0);
+        variable input_loss_now : std_logic;
+        variable config_error_now : std_logic;
+    begin
+        if rising_edge(clock) then
+            if reset = '1' then
+                state <= WAIT_START;
+                slot <= 0;
+                epoch_usable <= '0';
+                startup_transport_loss <= '0';
+                epoch_words <= (others => (others => '0'));
+                epoch_number <= (others => '0');
+                epoch_source_rx2 <= '0';
+                config_flags <= (others => '0');
+                loss_sticky <= '0';
+                config_sticky <= '0';
+                held_i <= (others => (others => '0'));
+                held_q <= (others => (others => '0'));
+                held_index <= (others => '0');
+                held_flags <= (others => '0');
+            else
+                input_loss_now := '0';
+                config_error_now := '0';
+                if data_phase = '1' then
+                    if s_valid = '1' and bank_s_ready = '0' then
+                        input_loss_now := '1';
+                    end if;
+                    if configuration_error = '1'
+                        or source_rx2 /= epoch_source_rx2
+                        or start_pulse = '1' then
+                        config_error_now := '1';
+                    end if;
+
+                    if input_loss_now = '1' or transport_loss = '1' then
+                        loss_sticky <= '1';
+                    end if;
+                    if config_error_now = '1' then
+                        config_sticky <= '1';
+                    end if;
+                end if;
+
+                case state is
+                    when WAIT_START =>
+                        if start_pulse = '1' then
+                            slot <= 0;
+                            epoch_source_rx2 <= source_rx2;
+                            loss_sticky <= '0';
+                            config_sticky <= '0';
+                            startup_transport_loss <= transport_loss;
+                            held_i <= (others => (others => '0'));
+                            held_q <= (others => (others => '0'));
+                            held_index <= (others => '0');
+                            held_flags <= (others => '0');
+
+                            flags := x"2010";
+                            flags(5) := source_rx2;
+                            if start_authorized = '1' and active_valid = '1'
+                                and active_epoch /= unsigned'(x"00000000")
+                                and configuration_error = '0'
+                                and transport_loss = '0' then
+                                epoch_usable <= '1';
+                                epoch_words <= active_words;
+                                epoch_number <= active_epoch;
+                                flags(3 downto 0) :=
+                                    std_logic_vector(active_epoch(3 downto 0));
+                            else
+                                epoch_usable <= '0';
+                                epoch_words <= (others => (others => '0'));
+                                epoch_number <= (others => '0');
+                                flags(6) := '1';
+                                flags(3 downto 0) := (others => '0');
+                            end if;
+                            config_flags <= flags;
+                            state <= EMIT_CONFIG;
+                        end if;
+
+                    when EMIT_CONFIG =>
+                        -- A new start is never allowed to replace the tuple being
+                        -- serialized. Preserve it and fail closed after CONFIG;
+                        -- no DATA may follow an in-flight lifecycle violation.
+                        if start_pulse = '1' or configuration_error = '1'
+                            or source_rx2 /= epoch_source_rx2 then
+                            config_sticky <= '1';
+                        end if;
+                        if transport_loss = '1' then
+                            startup_transport_loss <= '1';
+                        end if;
+
+                        if m_ready = '1' then
+                            if slot = 7 then
+                                slot <= 0;
+                                if epoch_usable = '1'
+                                    and startup_transport_loss = '0'
+                                    and transport_loss = '0'
+                                    and config_sticky = '0'
+                                    and start_pulse = '0'
+                                    and configuration_error = '0'
+                                    and source_rx2 = epoch_source_rx2 then
+                                    state <= DATA_WAIT_GROUP;
+                                else
+                                    state <= DIAGNOSTIC_DONE;
+                                end if;
+                            else
+                                slot <= slot + 1;
+                            end if;
+                        end if;
+
+                    when DATA_WAIT_GROUP =>
+                        if bank_m_valid = '1' then
+                            held_i <= bank_i;
+                            held_q <= bank_q;
+                            held_index <= bank_index;
+
+                            flags := x"2000";
+                            flags(11 downto 8) := bank_clipped;
+                            flags(7) := loss_sticky or transport_loss
+                                or input_loss_now;
+                            flags(6) := config_sticky or config_error_now;
+                            flags(5) := epoch_source_rx2;
+                            flags(3 downto 0) :=
+                                std_logic_vector(epoch_number(3 downto 0));
+                            held_flags <= flags;
+                            slot <= 0;
+                            state <= EMIT_DATA;
+                        end if;
+
+                    when EMIT_DATA =>
+                        if m_ready = '1' then
+                            if slot = 7 then
+                                slot <= 0;
+                                state <= DATA_WAIT_GROUP;
+                            else
+                                slot <= slot + 1;
+                            end if;
+                        end if;
+
+                    when DIAGNOSTIC_DONE =>
+                        -- A stop/reset is required before another start. Ignore
+                        -- any extra pulse rather than changing the emitted tuple.
+                        null;
+                end case;
+            end if;
+        end if;
+    end process;
+end architecture;
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_init_reset.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_init_reset.vhd
new file mode 100644
index 00000000..29932e8f
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_init_reset.vhd
@@ -0,0 +1,71 @@
+-- Image/PLL-lifetime initialization reset for profile-2 persistent control.
+-- The hosted FX3 system reset is a stream-lifecycle event and intentionally
+-- does not enter this block. Loss of the system PLL asynchronously asserts both
+-- outputs. After lock and a running system clock, the system-domain output is
+-- held for G_HOLD_CYCLES complete edges and then synchronously released. The RX
+-- output asynchronously asserts from that same event and synchronously releases
+-- through two RX-clock registers. If either clock is absent during release,
+-- that domain's reset remains asserted rather than relying on FPGA power-up
+-- state.
+
+library ieee;
+use ieee.std_logic_1164.all;
+
+entity rf_profile2_init_reset is
+    generic (
+        G_HOLD_CYCLES : positive := 16
+    );
+    port (
+        sys_clock : in std_logic;
+        sys_pll_locked : in std_logic;
+        rx_clock : in std_logic;
+        sys_reset : out std_logic;
+        rx_reset : out std_logic
+    );
+end entity;
+
+architecture rtl of rf_profile2_init_reset is
+    attribute ALTERA_ATTRIBUTE : string;
+    attribute PRESERVE : boolean;
+
+    signal hold_count : natural range 0 to G_HOLD_CYCLES := 0;
+    signal sys_reset_i : std_logic := '1';
+    signal rx_reset_meta : std_logic := '1';
+    signal rx_reset_sync : std_logic := '1';
+
+    attribute ALTERA_ATTRIBUTE of rx_reset_meta : signal is
+        "-name SYNCHRONIZER_IDENTIFICATION ""FORCED IF ASYNCHRONOUS""";
+    attribute ALTERA_ATTRIBUTE of rx_reset_sync : signal is
+        "-name SYNCHRONIZER_IDENTIFICATION ""FORCED IF ASYNCHRONOUS""";
+    attribute PRESERVE of rx_reset_meta : signal is true;
+    attribute PRESERVE of rx_reset_sync : signal is true;
+begin
+    sys_reset <= sys_reset_i;
+    rx_reset <= rx_reset_sync;
+
+    stretch_system_reset : process(sys_clock, sys_pll_locked)
+    begin
+        if sys_pll_locked /= '1' then
+            hold_count <= 0;
+            sys_reset_i <= '1';
+        elsif rising_edge(sys_clock) then
+            if hold_count < G_HOLD_CYCLES then
+                hold_count <= hold_count + 1;
+                sys_reset_i <= '1';
+            else
+                sys_reset_i <= '0';
+            end if;
+        end if;
+    end process;
+
+    synchronize_rx_release : process(rx_clock, sys_reset_i)
+    begin
+        if sys_reset_i = '1' then
+            rx_reset_meta <= '1';
+            rx_reset_sync <= '1';
+        elsif rising_edge(rx_clock) then
+            rx_reset_meta <= '0';
+            rx_reset_sync <= rx_reset_meta;
+        end if;
+    end process;
+end architecture;
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_integration.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_integration.vhd
new file mode 100644
index 00000000..e9c8fcb9
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_integration.vhd
@@ -0,0 +1,147 @@
+-- Profile-2 control, channel-bank transport and native-FIFO write boundary.
+-- The two reset classes are intentionally distinct:
+--
+-- * control_reset/profile_rx_reset are one image-lifetime event. They clear the
+--   committed configuration and one-shot start token, so a normal stream-start
+--   reset must not drive them.
+-- * stream_reset and a stopped rx_enable clear only epoch-local framing,
+--   numerical and packing state. A later start consumes a previously armed
+--   token and emits CONFIG again.
+--
+-- The wrapper owns the complete path from the terminating Wishbone slave to a
+-- single-driver 64-bit RX-FIFO write interface. fifo_full is backpressure, not
+-- a transport-loss event. Once DATA is open, the framer itself reports an
+-- unstallable ADC sample presented while that backpressure reaches the bank.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+library work;
+use work.rf_observatory_p.all;
+
+entity rf_profile2_integration is
+    port (
+        control_clock : in std_logic;
+        control_reset : in std_logic;
+
+        wb_address : in std_logic_vector(31 downto 0);
+        wb_write_data : in std_logic_vector(31 downto 0);
+        wb_read_data : out std_logic_vector(31 downto 0);
+        wb_write : in std_logic;
+        wb_select : in std_logic;
+        wb_strobe : in std_logic;
+        wb_cycle : in std_logic;
+        wb_ack : out std_logic;
+
+        rx_clock : in std_logic;
+        profile_rx_reset : in std_logic;
+        stream_reset : in std_logic;
+        rx_enable : in std_logic;
+
+        s_valid : in std_logic;
+        s_ready : out std_logic;
+        s_i : in signed(15 downto 0);
+        s_q : in signed(15 downto 0);
+        source_rx2 : in std_logic;
+        configuration_error : in std_logic;
+        transport_loss : in std_logic;
+
+        fifo_full : in std_logic;
+        fifo_write : out std_logic;
+        fifo_data : out std_logic_vector(63 downto 0)
+    );
+end entity;
+
+architecture rtl of rf_profile2_integration is
+    signal apply_valid, apply_done, apply_success : std_logic;
+    signal apply_words : phase_steps_t;
+    signal apply_epoch : unsigned(31 downto 0);
+    signal rx_active_sync : std_logic;
+
+    signal start_pulse, start_authorized : std_logic;
+    signal active_valid : std_logic;
+    signal active_words : phase_steps_t;
+    signal active_epoch : unsigned(31 downto 0);
+
+    signal epoch_reset : std_logic;
+    signal framed_valid, framed_ready : std_logic;
+    signal framed_i, framed_q : signed(15 downto 0);
+begin
+    epoch_reset <= profile_rx_reset or stream_reset or not rx_enable;
+
+    registers : entity work.rf_profile2_wb_registers
+        port map (
+            clock => control_clock,
+            reset => control_reset,
+            wb_address => wb_address,
+            wb_write_data => wb_write_data,
+            wb_read_data => wb_read_data,
+            wb_write => wb_write,
+            wb_select => wb_select,
+            wb_strobe => wb_strobe,
+            wb_cycle => wb_cycle,
+            wb_ack => wb_ack,
+            rx_active_sync => rx_active_sync,
+            apply_valid => apply_valid,
+            apply_words => apply_words,
+            apply_epoch => apply_epoch,
+            apply_done => apply_done,
+            apply_success => apply_success
+        );
+
+    control_bridge : entity work.rf_profile2_control_cdc
+        port map (
+            control_clock => control_clock,
+            control_reset => control_reset,
+            apply_valid => apply_valid,
