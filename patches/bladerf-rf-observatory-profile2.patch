diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_p.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_p.vhd
new file mode 100644
index 00000000..03cb477b
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_p.vhd
@@ -0,0 +1,100 @@
+-- Frozen control-register contract for RF-observatory profile 2. Profile 1
+-- keeps its existing package and wire bytes unchanged.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+package rf_profile2_p is
+    constant P2_ID : std_logic_vector(31 downto 0) := x"52460201";
+    constant P2_CAPABILITIES : std_logic_vector(31 downto 0) := x"00001f04";
+    constant P2_COMMIT_MAGIC : std_logic_vector(31 downto 0) := x"434d4954";
+    constant P2_UNKNOWN_READ : std_logic_vector(31 downto 0) := x"bad0add0";
+
+    constant P2_ADDR_ID : natural := 0;
+    constant P2_ADDR_CAPABILITIES : natural := 1;
+    constant P2_ADDR_SHADOW_FIRST : natural := 4;
+    constant P2_ADDR_COMMIT : natural := 8;
+    constant P2_ADDR_STATUS : natural := 9;
+    constant P2_ADDR_APPLIED_EPOCH : natural := 10;
+    constant P2_ADDR_OUTCOME_EPOCH : natural := 11;
+    constant P2_ADDR_APPLIED_FIRST : natural := 12;
+
+    subtype p2_reason_t is std_logic_vector(3 downto 0);
+    constant P2_REASON_NONE : p2_reason_t := x"0";
+    constant P2_REASON_BAD_MAGIC : p2_reason_t := x"1";
+    constant P2_REASON_INCOMPLETE : p2_reason_t := x"2";
+    constant P2_REASON_RX_ACTIVE : p2_reason_t := x"3";
+    constant P2_REASON_EPOCH_EXHAUSTED : p2_reason_t := x"4";
+    constant P2_REASON_APPLY_REJECTED : p2_reason_t := x"5";
+
+    function p2_epoch_available(epoch : unsigned(31 downto 0)) return boolean;
+    function p2_candidate_epoch(epoch : unsigned(31 downto 0)) return unsigned;
+    function p2_commit_reason(
+        commit_word : std_logic_vector(31 downto 0);
+        rx_active : std_logic;
+        written_mask : std_logic_vector(3 downto 0);
+        applied_epoch : unsigned(31 downto 0)
+    ) return p2_reason_t;
+    function p2_status(
+        busy : std_logic;
+        outcome_valid : std_logic;
+        outcome_success : std_logic;
+        rx_active : std_logic;
+        reason : p2_reason_t;
+        written_mask : std_logic_vector(3 downto 0)
+    ) return std_logic_vector;
+end package;
+
+package body rf_profile2_p is
+    function p2_epoch_available(epoch : unsigned(31 downto 0)) return boolean is
+    begin
+        return epoch /= unsigned'(x"ffffffff");
+    end function;
+
+    function p2_candidate_epoch(epoch : unsigned(31 downto 0)) return unsigned is
+    begin
+        if p2_epoch_available(epoch) then
+            return epoch + 1;
+        end if;
+        return epoch;
+    end function;
+
+    function p2_commit_reason(
+        commit_word : std_logic_vector(31 downto 0);
+        rx_active : std_logic;
+        written_mask : std_logic_vector(3 downto 0);
+        applied_epoch : unsigned(31 downto 0)
+    ) return p2_reason_t is
+    begin
+        if commit_word /= P2_COMMIT_MAGIC then
+            return P2_REASON_BAD_MAGIC;
+        elsif rx_active /= '0' then
+            return P2_REASON_RX_ACTIVE;
+        elsif written_mask /= "1111" then
+            return P2_REASON_INCOMPLETE;
+        elsif not p2_epoch_available(applied_epoch) then
+            return P2_REASON_EPOCH_EXHAUSTED;
+        end if;
+        return P2_REASON_NONE;
+    end function;
+
+    function p2_status(
+        busy : std_logic;
+        outcome_valid : std_logic;
+        outcome_success : std_logic;
+        rx_active : std_logic;
+        reason : p2_reason_t;
+        written_mask : std_logic_vector(3 downto 0)
+    ) return std_logic_vector is
+        variable value : std_logic_vector(31 downto 0) := (others => '0');
+    begin
+        value(31) := busy;
+        value(30) := outcome_valid;
+        value(29) := outcome_success;
+        value(28) := rx_active;
+        value(27 downto 24) := reason;
+        value(23 downto 20) := written_mask;
+        return value;
+    end function;
+end package body;
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_slot_packer.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_slot_packer.vhd
new file mode 100644
index 00000000..c7873924
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_slot_packer.vhd
@@ -0,0 +1,68 @@
+-- Lossless two-slot adapter from the profile-2 ready/valid stream to the
+-- native bladeRF RX FIFO's 64-bit write port. A complex int16 slot occupies
+-- one 32-bit host word with I in the low half and Q in the high half. The
+-- lower FIFO word is therefore the first accepted slot.
+--
+-- fifo_full must be the actual write-domain full output of the target FIFO.
+-- The pinned Cyclone-V DCFIFO also holds that output high while its synchronized
+-- write-side asynchronous clear is releasing. The empty half buffer may retain
+-- one slot during that interval, but a pair is accepted and written only when
+-- fifo_full is low. Reset discards an unpaired slot and suppresses writes.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity rf_profile2_slot_packer is
+    port (
+        clock : in std_logic;
+        reset : in std_logic;
+
+        m_valid : in std_logic;
+        m_ready : out std_logic;
+        m_i : in signed(15 downto 0);
+        m_q : in signed(15 downto 0);
+
+        fifo_full : in std_logic;
+        fifo_write : out std_logic;
+        fifo_data : out std_logic_vector(63 downto 0)
+    );
+end entity;
+
+architecture rtl of rf_profile2_slot_packer is
+    signal half_valid : std_logic := '0';
+    signal first_i : signed(15 downto 0) := (others => '0');
+    signal first_q : signed(15 downto 0) := (others => '0');
+    signal ready_i : std_logic;
+begin
+    ready_i <= '0' when reset = '1' else
+        '1' when half_valid = '0' else
+        '1' when fifo_full = '0' else '0';
+    m_ready <= ready_i;
+
+    -- The second-slot handshake and FIFO write are the same event. In
+    -- particular, accepting CONFIG slot 7 writes the final CONFIG pair.
+    fifo_write <= '1' when reset = '0' and half_valid = '1'
+        and m_valid = '1' and fifo_full = '0' else '0';
+    fifo_data <= std_logic_vector(m_q) & std_logic_vector(m_i)
+        & std_logic_vector(first_q) & std_logic_vector(first_i);
+
+    retain_first_slot : process(clock)
+    begin
+        if rising_edge(clock) then
+            if reset = '1' then
+                half_valid <= '0';
+                first_i <= (others => '0');
+                first_q <= (others => '0');
+            elsif m_valid = '1' and ready_i = '1' then
+                if half_valid = '0' then
+                    first_i <= m_i;
+                    first_q <= m_q;
+                    half_valid <= '1';
+                else
+                    half_valid <= '0';
+                end if;
+            end if;
+        end if;
+    end process;
+end architecture;
diff --git a/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_wb_registers.vhd b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_wb_registers.vhd
new file mode 100644
index 00000000..6b9d4286
--- /dev/null
+++ b/hdl/fpga/ip/nuand/rf_observatory/rf_profile2_wb_registers.vhd
@@ -0,0 +1,210 @@
+-- Always-terminating profile-2 register slave for the pinned Nuand bridge.
+-- Capture belongs to cyc/stb; sel is the later response-wait indication.
+-- The apply payload remains stable while apply_valid is high.
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+library work;
+use work.rf_observatory_p.all;
+use work.rf_profile2_p.all;
+
+entity rf_profile2_wb_registers is
+    port (
+        clock : in std_logic;
+        reset : in std_logic;
+
+        wb_address : in std_logic_vector(31 downto 0);
+        wb_write_data : in std_logic_vector(31 downto 0);
+        wb_read_data : out std_logic_vector(31 downto 0);
+        wb_write : in std_logic;
+        wb_select : in std_logic;
+        wb_strobe : in std_logic;
+        wb_cycle : in std_logic;
+        wb_ack : out std_logic;
+
+        rx_active_sync : in std_logic;
+        apply_valid : out std_logic;
+        apply_words : out phase_steps_t;
+        apply_epoch : out unsigned(31 downto 0);
+        apply_done : in std_logic;
+        apply_success : in std_logic
+    );
+end entity;
+
+architecture rtl of rf_profile2_wb_registers is
+    type bus_state_t is (IDLE, WAIT_SELECT, RESPOND, WAIT_RELEASE);
+
+    signal bus_state : bus_state_t := IDLE;
+    signal saved_address : unsigned(31 downto 0) := (others => '0');
+    signal saved_data : std_logic_vector(31 downto 0) := (others => '0');
+    signal saved_write : std_logic := '0';
+    signal response_data : std_logic_vector(31 downto 0) := (others => '0');
+
+    signal shadow_words : phase_steps_t := (others => (others => '0'));
+    signal written_mask : std_logic_vector(3 downto 0) := (others => '0');
+    signal frozen_words : phase_steps_t := (others => (others => '0'));
+    signal frozen_epoch : unsigned(31 downto 0) := (others => '0');
+    signal applied_words : phase_steps_t := (others => (others => '0'));
+    signal applied_epoch : unsigned(31 downto 0) := (others => '0');
+    signal apply_pending : std_logic := '0';
+    signal previous_apply_done : std_logic := '0';
+
+    signal outcome_valid : std_logic := '0';
+    signal outcome_success : std_logic := '0';
+    signal outcome_reason : p2_reason_t := P2_REASON_NONE;
+    signal outcome_epoch : unsigned(31 downto 0) := (others => '0');
+begin
+    wb_ack <= '1' when bus_state = RESPOND else '0';
+    wb_read_data <= response_data;
+    apply_valid <= apply_pending;
+    apply_words <= frozen_words;
+    apply_epoch <= frozen_epoch;
+
+    process(clock, reset)
+        variable address : natural range 0 to 15;
+        variable next_epoch : unsigned(31 downto 0);
+        variable commit_reason : p2_reason_t;
+    begin
+        if reset = '1' then
+            bus_state <= IDLE;
+            saved_address <= (others => '0');
+            saved_data <= (others => '0');
+            saved_write <= '0';
+            response_data <= (others => '0');
+            shadow_words <= (others => (others => '0'));
+            written_mask <= (others => '0');
+            frozen_words <= (others => (others => '0'));
+            frozen_epoch <= (others => '0');
+            applied_words <= (others => (others => '0'));
+            applied_epoch <= (others => '0');
+            apply_pending <= '0';
+            previous_apply_done <= '0';
+            outcome_valid <= '0';
+            outcome_success <= '0';
+            outcome_reason <= P2_REASON_NONE;
+            outcome_epoch <= (others => '0');
+        elsif rising_edge(clock) then
+            previous_apply_done <= apply_done;
+            if apply_done = '1' and previous_apply_done = '0'
+                and apply_pending = '1' then
+                apply_pending <= '0';
+                outcome_valid <= '1';
+                outcome_epoch <= frozen_epoch;
+                if apply_success = '1' then
+                    applied_words <= frozen_words;
+                    applied_epoch <= frozen_epoch;
+                    outcome_success <= '1';
+                    outcome_reason <= P2_REASON_NONE;
+                else
+                    outcome_success <= '0';
+                    outcome_reason <= P2_REASON_APPLY_REJECTED;
+                end if;
+            end if;
+
+            case bus_state is
+                when IDLE =>
+                    if wb_cycle = '1' and wb_strobe = '1' then
+                        saved_address <= unsigned(wb_address);
+                        saved_data <= wb_write_data;
+                        saved_write <= wb_write;
+                        bus_state <= WAIT_SELECT;
+                    end if;
+
+                when WAIT_SELECT =>
+                    if wb_select = '1' then
+                        response_data <= (others => '0');
+                        if saved_address(31 downto 4) = 0 then
+                            address := to_integer(saved_address(3 downto 0));
+                            if saved_write = '1' then
+                                case address is
+                                    when P2_ADDR_SHADOW_FIRST to P2_ADDR_SHADOW_FIRST + 3 =>
+                                        shadow_words(address - P2_ADDR_SHADOW_FIRST) <=
+                                            unsigned(saved_data);
+                                        written_mask(address - P2_ADDR_SHADOW_FIRST) <= '1';
+
+                                    when P2_ADDR_COMMIT =>
+                                        next_epoch := p2_candidate_epoch(applied_epoch);
+                                        commit_reason := P2_REASON_NONE;
+                                        if apply_pending = '1' then
+                                            null;
+                                        else
+                                            commit_reason := p2_commit_reason(
+                                                saved_data, rx_active_sync,
+                                                written_mask, applied_epoch
+                                            );
+                                        end if;
+                                        if apply_pending = '0'
+                                            and commit_reason /= P2_REASON_NONE then
+                                            outcome_valid <= '1';
+                                            outcome_success <= '0';
+                                            outcome_reason <= commit_reason;
+                                            outcome_epoch <= next_epoch;
+                                        elsif apply_pending = '0' then
+                                            frozen_words <= shadow_words;
+                                            frozen_epoch <= next_epoch;
+                                            apply_pending <= '1';
+                                            written_mask <= (others => '0');
+                                            outcome_valid <= '0';
+                                            outcome_success <= '0';
+                                            outcome_reason <= P2_REASON_NONE;
+                                            outcome_epoch <= next_epoch;
+                                        end if;
+
+                                    when others =>
+                                        null;
+                                end case;
+                            else
+                                case address is
+                                    when P2_ADDR_ID =>
+                                        response_data <= P2_ID;
+                                    when P2_ADDR_CAPABILITIES =>
+                                        response_data <= P2_CAPABILITIES;
+                                    when P2_ADDR_SHADOW_FIRST to P2_ADDR_SHADOW_FIRST + 3 =>
+                                        response_data <= std_logic_vector(
+                                            shadow_words(address - P2_ADDR_SHADOW_FIRST)
+                                        );
+                                    when P2_ADDR_COMMIT =>
+                                        response_data <= (others => '0');
+                                    when P2_ADDR_STATUS =>
+                                        response_data <= p2_status(
+                                            apply_pending, outcome_valid, outcome_success,
+                                            rx_active_sync, outcome_reason, written_mask
+                                        );
+                                    when P2_ADDR_APPLIED_EPOCH =>
+                                        response_data <= std_logic_vector(applied_epoch);
+                                    when P2_ADDR_OUTCOME_EPOCH =>
+                                        response_data <= std_logic_vector(outcome_epoch);
+                                    when P2_ADDR_APPLIED_FIRST to P2_ADDR_APPLIED_FIRST + 3 =>
+                                        response_data <= std_logic_vector(
+                                            applied_words(address - P2_ADDR_APPLIED_FIRST)
+                                        );
+                                    when others =>
+                                        response_data <= P2_UNKNOWN_READ;
+                                end case;
+                            end if;
+                        elsif saved_write = '0' then
+                            response_data <= P2_UNKNOWN_READ;
+                        end if;
+                        bus_state <= RESPOND;
+                    end if;
+
+                when RESPOND =>
+                    bus_state <= WAIT_RELEASE;
+
+                when WAIT_RELEASE =>
+                    if wb_select = '0' then
+                        if wb_cycle = '1' and wb_strobe = '1' then
+                            saved_address <= unsigned(wb_address);
+                            saved_data <= wb_write_data;
+                            saved_write <= wb_write;
+                            bus_state <= WAIT_SELECT;
+                        else
+                            bus_state <= IDLE;
+                        end if;
+                    end if;
+            end case;
+        end if;
+    end process;
+end architecture;
