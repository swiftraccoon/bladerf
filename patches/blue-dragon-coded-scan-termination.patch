+fn dewhiten_coded_bytes(bits: &[u8], channel: u32) -> Vec<u8> {
+    let (whole_bytes, _) = bits.as_chunks::<8>();
+    whole_bytes
+        .iter()
+        .enumerate()
+        .map(|(byte_index, bits)| {
+            let mut value = 0;
+            for (bit_index, &bit) in bits.iter().enumerate() {
+                let position = (byte_index * 8 + bit_index) as u32;
+                value |= (bit ^ whitening_bit(channel, position)) << bit_index;
+            }
+            value
+        })
+        .collect()
+}
+
+fn coded_pdu_crc_matches(bytes: &[u8], crc_init: u32) -> bool {
+    let Some((body, crc)) = bytes.split_last_chunk::<3>() else {
+        return false;
+    };
+    crc24(body, crc_init) == u32::from_le_bytes([crc[0], crc[1], crc[2], 0])
+}
+
+fn retry_terminated_coded_block2(
+    soft_coded: &[f32],
+    channel: u32,
+    payload_length: usize,
+    crc_init: u32,
+) -> Option<Vec<u8>> {
+    if payload_length > CODED_MAX_PDU_BYTES {
+        return None;
+    }
+    let packet_bytes = 2 + payload_length + 3;
+    // The header bounds the trellis to PDU, CRC and three TERM2 bits.
+    let terminated_bits = packet_bytes * 8 + 3;
+    let (decoded, _, termination_metric) =
+        crate::fec::viterbi_decode_terminated(soft_coded.get(..2 * terminated_bits)?);
+    if !termination_metric.is_finite() {
+        return None;
+    }
+    let bytes = dewhiten_coded_bytes(&decoded, channel);
+    if bytes.len() != packet_bytes
+        || usize::from(bytes[1]) != payload_length
+        || !coded_pdu_crc_matches(&bytes, crc_init)
+    {
+        return None;
+    }
+    Some(bytes)
+}
