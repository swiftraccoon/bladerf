+    fn coded_packet_metrics(bytes: &[u8], channel: u32) -> Vec<f32> {
+        let mut bits = Vec::new();
+        for (byte_index, &octet) in bytes.iter().enumerate() {
+            for bit_index in 0..8 {
+                let position = (byte_index * 8 + bit_index) as u32;
+                bits.push(((octet >> bit_index) & 1) ^ whitening_bit(channel, position));
+            }
+        }
+        crate::fec::conv_encode(&bits)
+            .into_iter()
+            .map(|bit| if bit == 0 { 1.0 } else { -1.0 })
+            .collect()
+    }
