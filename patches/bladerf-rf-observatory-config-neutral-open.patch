+++ b/host/libraries/libbladeRF/include/libbladeRF.h
@@ -53,6 +53,11 @@
  */
 #define LIBBLADERF_API_VERSION (0x02060000)
 
+/** Versioned marker returned by
+ * bladerf_get_bladerf2_config_neutral_open_marker() when the specialized open
+ * contract is enabled. The value encodes "B2N" followed by revision 1. */
+#define BLADERF2_CONFIG_NEUTRAL_OPEN_MARKER_V1 UINT32_C(0x42324e01)
+
 #ifdef __cplusplus
 extern "C" {
 #else
@@ -4467,6 +4472,23 @@ void CALL_CONV bladerf_log_set_verbosity(bladerf_log_level level);
 API_EXPORT
 void CALL_CONV bladerf_version(struct bladerf_version *version);
 
+/**
+ * Query this patched library's specialized bladeRF 2 open contract.
+ *
+ * A return value of ::BLADERF2_CONFIG_NEUTRAL_OPEN_MARKER_V1 means
+ * bladerf_open() accepts only an already-configured bladeRF 2, skips automatic
+ * FPGA loading, board/RFIC initialization, configuration-file processing and
+ * scheduled-retune cancellation, and was built without USB reset-on-open.
+ * The USB backend still claims the interface and selects alternate settings,
+ * including NULL, SPI-flash and RF-link modes.
+ * Explicit API calls, including Wishbone writes, can still change the device.
+ *
+ * @return ::BLADERF2_CONFIG_NEUTRAL_OPEN_MARKER_V1 when enabled, or
+ *         zero in the default build.
+ */
+API_EXPORT
+uint32_t CALL_CONV bladerf_get_bladerf2_config_neutral_open_marker(void);
+
 /** @} (End of FN_LIBRARY_VERSION) */
 
 /**
