+++ b/host/libraries/libbladeRF/src/bladerf.c
@@ -164,13 +164,15 @@ int bladerf_open_with_devinfo(struct bladerf **opened_device,
         return status;
     }
 
-    /* Load configuration file */
+    /* The specialized bladeRF 2 open contract never processes bladeRF.conf. */
+#if !defined(ENABLE_LIBBLADERF_BLADERF2_CONFIG_NEUTRAL_OPEN)
     status = config_load_options_file(dev);
 
     if (status < 0) {
         bladerf_close(dev);
         return status;
     }
+#endif
 
     *opened_device = dev;
 
@@ -530,6 +532,15 @@ void bladerf_version(struct bladerf_version *version)
     version->describe = LIBBLADERF_VERSION;
 }
 
+uint32_t bladerf_get_bladerf2_config_neutral_open_marker(void)
+{
+#if defined(ENABLE_LIBBLADERF_BLADERF2_CONFIG_NEUTRAL_OPEN)
+    return BLADERF2_CONFIG_NEUTRAL_OPEN_MARKER_V1;
+#else
+    return 0;
+#endif
+}
+
 /******************************************************************************/
 /* Enable/disable */
 /******************************************************************************/
