+/// Closed subpartition of terminal OFDM DATA recovery failures.
+///
+/// Each event is also counted once by
+/// [`OfdmRejectionStats::data_decode_failed`]. These fields classify the
+/// decoder path selected by a supported header. They do not prove a physical
+/// frame, transmitter, or over-the-air PHY identity.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct OfdmDataFailureStats {
+    /// Legacy OFDM with BCC coding.
+    pub legacy: u64,
+    /// HT20 whose integrity-checked HT-SIG selected BCC coding.
+    pub ht_bcc: u64,
+    /// HT20 whose integrity-checked HT-SIG selected LDPC coding.
+    pub ht_ldpc: u64,
+}
+
+impl OfdmDataFailureStats {
+    fn counts(self) -> [u64; 3] {
+        [self.legacy, self.ht_bcc, self.ht_ldpc]
+    }
+
+    fn from_counts(counts: [u64; 3]) -> Self {
+        let [legacy, ht_bcc, ht_ldpc] = counts;
+        Self {
+            legacy,
+            ht_bcc,
+            ht_ldpc,
+        }
+    }
+
+    /// Returns the exact sum when the public counters have not been externally
+    /// constructed with an overflowing total.
+    pub fn checked_total(self) -> Option<u64> {
+        self.counts().into_iter().try_fold(0u64, u64::checked_add)
+    }
+
+    pub(in crate::radio) fn saturating_add_to(self, other: Self, limit: u64) -> Self {
+        let Some(total) = self.checked_total() else {
+            return self;
+        };
+        debug_assert!(total <= limit);
+        let mut result = self.counts();
+        let mut remaining = limit.saturating_sub(total);
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            let increment = value.min(remaining);
+            *count += increment;
+            remaining -= increment;
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_add_each(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_add(value);
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_sub(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_sub(value);
+        }
+        Self::from_counts(result)
+    }
+}
