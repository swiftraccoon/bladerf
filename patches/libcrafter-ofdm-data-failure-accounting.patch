+        OfdmDataFailure::Legacy => &mut data_failures.legacy,
+        OfdmDataFailure::HtBcc => &mut data_failures.ht_bcc,
+        OfdmDataFailure::HtLdpc => &mut data_failures.ht_ldpc,
+    };
+    debug_assert_ne!(*count, u64::MAX);
+    *count += 1;
+}
