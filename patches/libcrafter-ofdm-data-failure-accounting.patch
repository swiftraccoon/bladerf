+fn data_failure_paths_propagate_through_serial_parallel_and_windowed_decoders() {
+    let legacy = include_bytes!("fixtures/iq/ofdm-6-invalid_service.cs8");
+    let mut ht_bcc = include_bytes!("fixtures/iq/ht-bcc-0-gi800-len100-clean.cs8").to_vec();
+    let bcc_end = ht_bcc.len() / 2 - 64;
+    ht_bcc[757 * 2..bcc_end * 2].fill(0);
+    let ht_ldpc = include_bytes!("fixtures/iq/ht-ldpc-7-invalid_service.cs8");
+
+    for (name, bytes, expected_path) in [
+        ("legacy", legacy.as_slice(), 0),
+        ("ht_bcc", ht_bcc.as_slice(), 1),
+        ("ht_ldpc", ht_ldpc.as_slice(), 2),
+    ] {
+        let snapshots = wifi_failure_snapshots(bytes);
+        assert_eq!(snapshots[1], snapshots[0], "{name}: parallel");
+        assert_eq!(snapshots[2], snapshots[0], "{name}: windowed");
+        let (stats, rejections, data_failures) = snapshots[0];
+        assert_eq!(rejections.checked_total(), Some(stats.rejected_frames));
+        assert_eq!(
+            data_failures.checked_total(),
+            Some(rejections.data_decode_failed)
+        );
+        assert!(rejections.data_decode_failed > 0, "{name}");
+        let counts = [
+            data_failures.legacy,
+            data_failures.ht_bcc,
+            data_failures.ht_ldpc,
+        ];
+        assert_eq!(
+            counts[expected_path], rejections.data_decode_failed,
+            "{name}"
+        );
+        assert_eq!(
+            counts
+                .into_iter()
+                .enumerate()
+                .filter(|(index, _)| *index != expected_path)
+                .map(|(_, count)| count)
+                .sum::<u64>(),
+            0,
+            "{name}"
+        );
+    }
+}
