+/// Closed accounting for terminal OFDM rejection branches.
+///
+/// These are decoder-hypothesis events, not physical frames. Strong,
+/// weak-short-period, and reference-relaxed acquisition paths can describe the
+/// same transmission. Diagnostics are a separate bounded, overlapping stream
+/// and are not the source of these counts.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct OfdmRejectionStats {
+    /// Neither the retained L-SIG path nor its optional greenfield probe could
+    /// continue. This branch also includes reservation failures.
+    pub signal_or_probe_rejected: u64,
+    /// A greenfield header reached the receiver's combined unsupported outcome.
+    /// That outcome includes unsupported fields and configured bounds.
+    pub greenfield_header_unsupported: u64,
+    /// A greenfield probe did not recognize HT and no legacy header was retained.
+    pub greenfield_probe_unrecognized: u64,
+    /// A mixed-format header reached the receiver's combined unsupported outcome.
+    /// That outcome includes unsupported fields and configured bounds.
+    pub mixed_header_unsupported: u64,
+    /// A non-HT mixed-format probe could not reserve its legacy fallback.
+    pub legacy_fallback_unreservable: u64,
+    /// A supported header reached DATA recovery, which then failed.
+    pub data_decode_failed: u64,
+    /// A synchronized hypothesis lacked a pending slot or initial sample budget.
+    pub pending_capacity_rejected: u64,
+    /// A strong short-period hypothesis timed out without accepted long
+    /// training. A weak-short-period hypothesis or reference-relaxed probe may
+    /// still recover the same waveform.
+    pub strong_long_training_not_found: u64,
+}
+
+/// Closed subpartition of strong-path long-training timeouts.
+///
+/// Each event is also counted once by
+/// [`OfdmRejectionStats::strong_long_training_not_found`]. The categories
+/// describe the furthest acquisition gate reached before the strong candidate
+/// expired. They remain decoder-hypothesis evidence, not missed frames.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct OfdmStrongLongTrainingStats {
+    /// The candidate expired before any eligible long-training evaluation;
+    /// this does not prove that every intervening sample remained periodic.
+    pub strong_short_periodicity_timeout: u64,
+    /// No evaluated window contained the required repeated long-training form.
+    pub strong_long_repeat_not_found: u64,
+    /// A repeated form did not pass the known long-training reference gate.
+    pub strong_long_reference_not_found: u64,
+    /// Reference evidence passed, but source-coordinate arithmetic could not
+    /// form valid packet positions. This is not generic missing history.
+    pub strong_long_coordinates_unavailable: u64,
+}
+
+impl OfdmStrongLongTrainingStats {
+    fn counts(self) -> [u64; 4] {
+        [
+            self.strong_short_periodicity_timeout,
+            self.strong_long_repeat_not_found,
+            self.strong_long_reference_not_found,
+            self.strong_long_coordinates_unavailable,
+        ]
+    }
+
+    fn from_counts(counts: [u64; 4]) -> Self {
+        let [strong_short_periodicity_timeout, strong_long_repeat_not_found, strong_long_reference_not_found, strong_long_coordinates_unavailable] =
+            counts;
+        Self {
+            strong_short_periodicity_timeout,
+            strong_long_repeat_not_found,
+            strong_long_reference_not_found,
+            strong_long_coordinates_unavailable,
+        }
+    }
+
+    /// Returns the exact sum when the public counters have not been externally
+    /// constructed with an overflowing total.
+    pub fn checked_total(self) -> Option<u64> {
+        self.counts().into_iter().try_fold(0u64, u64::checked_add)
+    }
+
+    pub(in crate::radio) fn saturating_add_to(self, other: Self, limit: u64) -> Self {
+        let Some(total) = self.checked_total() else {
+            return self;
+        };
+        debug_assert!(total <= limit);
+        let mut result = self.counts();
+        let mut remaining = limit.saturating_sub(total);
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            let increment = value.min(remaining);
+            *count += increment;
+            remaining -= increment;
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_add_each(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_add(value);
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_sub(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_sub(value);
+        }
+        Self::from_counts(result)
+    }
+}
+
