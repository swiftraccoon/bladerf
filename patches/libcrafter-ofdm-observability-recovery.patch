+
+    /// Returns the exact sum when the public counters have not been externally
+    /// constructed with an overflowing total.
+    pub fn checked_total(self) -> Option<u64> {
+        self.counts().into_iter().try_fold(0u64, u64::checked_add)
+    }
+
+    pub(in crate::radio) fn saturating_add(self, other: Self) -> Self {
+        let Some(total) = self.checked_total() else {
+            return self;
+        };
+        let mut result = self.counts();
+        let mut remaining = u64::MAX - total;
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            let increment = value.min(remaining);
+            *count += increment;
+            remaining -= increment;
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_add_each(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_add(value);
+        }
+        Self::from_counts(result)
+    }
+
+    pub(in crate::radio) fn saturating_sub(self, other: Self) -> Self {
+        let mut result = self.counts();
+        for (count, value) in result.iter_mut().zip(other.counts()) {
+            *count = count.saturating_sub(value);
+        }
+        Self::from_counts(result)
+    }
+}
