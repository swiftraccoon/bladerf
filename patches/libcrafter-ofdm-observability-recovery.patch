+#[derive(Clone, Copy)]
+enum OfdmRejection {
+    SignalOrProbe,
+    GreenfieldHeaderUnsupported,
+    GreenfieldProbeUnrecognized,
+    MixedHeaderUnsupported,
+    LegacyFallbackUnreservable,
+    DataDecodeFailed,
+    PendingCapacity,
+}
+
+fn record_rejection(
+    stats: &mut DecoderStats,
+    rejections: &mut OfdmRejectionStats,
+    reason: OfdmRejection,
+) {
+    if stats.rejected_frames == u64::MAX {
+        return;
+    }
+    stats.rejected_frames += 1;
+    let count = match reason {
+        OfdmRejection::SignalOrProbe => &mut rejections.signal_or_probe_rejected,
+        OfdmRejection::GreenfieldHeaderUnsupported => &mut rejections.greenfield_header_unsupported,
+        OfdmRejection::GreenfieldProbeUnrecognized => &mut rejections.greenfield_probe_unrecognized,
+        OfdmRejection::MixedHeaderUnsupported => &mut rejections.mixed_header_unsupported,
+        OfdmRejection::LegacyFallbackUnreservable => &mut rejections.legacy_fallback_unreservable,
+        OfdmRejection::DataDecodeFailed => &mut rejections.data_decode_failed,
+        OfdmRejection::PendingCapacity => &mut rejections.pending_capacity_rejected,
+    };
+    debug_assert_ne!(*count, u64::MAX);
+    *count += 1;
+}
+
+fn record_strong_long_training_failure(
+    stats: &mut DecoderStats,
+    rejections: &mut OfdmRejectionStats,
+    strong_long_training: &mut OfdmStrongLongTrainingStats,
+    reason: StrongLongTrainingFailure,
+) {
+    debug_assert_eq!(rejections.checked_total(), Some(stats.rejected_frames));
+    debug_assert_eq!(
+        strong_long_training.checked_total(),
+        Some(rejections.strong_long_training_not_found)
+    );
+    if stats.rejected_frames == u64::MAX {
+        return;
+    }
+    debug_assert_ne!(rejections.strong_long_training_not_found, u64::MAX);
+    stats.rejected_frames += 1;
+    rejections.strong_long_training_not_found += 1;
+    let count = match reason {
+        StrongLongTrainingFailure::ShortPeriodicityTimeout => {
+            &mut strong_long_training.strong_short_periodicity_timeout
+        }
+        StrongLongTrainingFailure::LongRepeatNotFound => {
+            &mut strong_long_training.strong_long_repeat_not_found
+        }
+        StrongLongTrainingFailure::LongReferenceNotFound => {
+            &mut strong_long_training.strong_long_reference_not_found
+        }
+        StrongLongTrainingFailure::LongCoordinatesUnavailable => {
+            &mut strong_long_training.strong_long_coordinates_unavailable
+        }
+    };
+    debug_assert_ne!(*count, u64::MAX);
+    *count += 1;
+}
