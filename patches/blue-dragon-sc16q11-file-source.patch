+// The decoder receives two samples per 1 Msym/s physical symbol. A minimum
+// S=2 packet is 462 symbols; 2,000 samples remains only an ordering heuristic.
+const CODED_MIN_S2_PACKET_SAMPLES: usize = 924;
+const CODED_PRIORITY_THRESHOLD_SAMPLES: usize = 2_000;
+
+fn aligned_file_block_size(num_channels: usize) -> Result<usize, String> {
+    if num_channels < 2 || num_channels % 2 != 0 {
+        return Err("file input requires an even channel count of at least 2".to_string());
+    }
+    let complex_samples_per_step = num_channels / 2;
+    let steps_per_block = (65_536 / complex_samples_per_step).max(1);
+    Ok(steps_per_block * complex_samples_per_step)
+}
+
+fn is_primary_advertising_frequency(freq_mhz: u32) -> bool {
+    matches!(freq_mhz, 2402 | 2426 | 2480)
+}
+
+fn uses_coded_scan_catcher(freq_mhz: u32, coded_scan: bool) -> bool {
+    coded_scan && is_primary_advertising_frequency(freq_mhz)
+}
+
+fn validate_coded_scan_grid(channel_freqs: &[u32], coded_scan: bool) -> Result<(), String> {
+    if coded_scan
+        && !channel_freqs
+            .iter()
+            .any(|&freq| is_primary_advertising_frequency(freq))
+    {
+        return Err(
+            "--coded-scan requires an exact FFT bin at 2402, 2426, or 2480 MHz; adjust --center-freq or --channels"
+                .to_string(),
+        );
+    }
+    Ok(())
+}
