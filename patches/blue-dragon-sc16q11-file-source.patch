+enum CodedScanResult {
+    NoPacket,
+    Rejected,
+    Duplicate,
+    Packet(ble::BlePacket),
+}
+
+fn classify_coded_scan_packet(
+    mut packet: ble::BlePacket,
+    rssi_db: i32,
+    noise_db: i32,
+    conn_table: &mut ConnectionTable,
+) -> CodedScanResult {
+    packet.rssi_db = rssi_db;
+    packet.noise_db = noise_db;
+    if packet.phy != ble::BlePhy::PhyCoded || !packet.crc_checked || !packet.crc_valid {
+        return CodedScanResult::Rejected;
+    }
+    if conn_table.is_coded_copy(&packet) {
+        return CodedScanResult::Duplicate;
+    }
+    CodedScanResult::Packet(packet)
+}
+
+/// Decode a continuous scan window as coded PHY only. Scan output is stricter
+/// than ordinary burst decoding: only CRC-checked, CRC-valid packets survive.
+fn decode_coded_scan_burst(
+    burst: &bd_dsp::burst::Burst,
+    fsk: &mut FskDemod,
+    conn_table: &mut ConnectionTable,
+) -> CodedScanResult {
+    let raw_demod = fsk.fm_discriminate_raw(&burst.samples);
+    let packet = ble::ble_coded_burst_search(
+        &raw_demod,
+        burst.freq,
+        burst.timestamp.clone(),
+        2,
+        true,
+        &mut |aa| conn_table.crc_init_for_aa(aa, burst.timestamp.tv_sec),
+        raw_demod.len(),
+    );
+    match packet {
+        Some(packet) => classify_coded_scan_packet(
+            packet,
+            burst.rssi_db as i32,
+            burst.noise_db as i32,
+            conn_table,
+        ),
+        None => CodedScanResult::NoPacket,
+    }
+}
