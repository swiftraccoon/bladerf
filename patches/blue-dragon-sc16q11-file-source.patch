+mod tests {
+    use super::*;
+    use std::io::Write;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+    fn q11_file(components: &[i16], trailing: &[u8]) -> std::path::PathBuf {
+        let path = std::env::temp_dir().join(format!(
+            "blue-dragon-q11-{}-{}",
+            std::process::id(),
+            SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        let mut file = File::create(&path).unwrap();
+        for value in components {
+            file.write_all(&value.to_le_bytes()).unwrap();
+        }
+        file.write_all(trailing).unwrap();
+        file.flush().unwrap();
+        path
+    }
+
+    #[test]
+    fn sc16_q11_matches_live_bladerf_scaling() {
+        let file = q11_file(&[-2048, 2047, -1, 1], &[]);
+        let input = File::open(&file).unwrap();
+        let mut reader = BufReader::new(input);
+        let samples = FileSource::read_block_sc16_q11(&mut reader, 8)
+            .unwrap()
+            .unwrap();
+        assert_eq!(samples, [-32768, 32752, -16, 16]);
+        assert!(
+            FileSource::read_block_sc16_q11(&mut reader, 8)
+                .unwrap()
+                .is_none()
+        );
+        std::fs::remove_file(file).unwrap();
+    }
+
+    #[test]
+    fn sc16_q11_rejects_invalid_components_and_partial_samples() {
+        let file = q11_file(&[2048, 0], &[]);
+        let mut reader = BufReader::new(File::open(&file).unwrap());
+        assert_eq!(
+            FileSource::read_block_sc16_q11(&mut reader, 1)
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidData
+        );
+        std::fs::remove_file(file).unwrap();
+
+        let file = q11_file(&[0], &[0]);
+        let mut reader = BufReader::new(File::open(&file).unwrap());
+        assert_eq!(
+            FileSource::read_block_sc16_q11(&mut reader, 1)
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidData
+        );
+        std::fs::remove_file(file).unwrap();
+    }
+}
