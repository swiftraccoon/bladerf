+        let bytes_needed = num_samples * 4; // 4 bytes per complex sample
+        let mut buf = vec![0u8; bytes_needed];
+        let mut n = 0;
+        while n < bytes_needed {
+            match reader.read(&mut buf[n..]) {
+                Ok(0) => break,
