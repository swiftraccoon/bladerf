+    fn coded_scan_fixture(pdu: &[u8], ci: u8, valid_crc: bool) -> Vec<f32> {
+        use crate::fec;
+
+        let bits = |byte: u8| (0..8).map(move |bit| (byte >> bit) & 1);
+        let mut block1: Vec<_> = BLE_ADV_AA.to_le_bytes().into_iter().flat_map(bits).collect();
+        block1.extend_from_slice(&[ci, 0]);
+        let crc = crc24(pdu, 0x555555) ^ u32::from(!valid_crc);
+        let pdu_crc = pdu.iter().copied().chain(crc.to_le_bytes().into_iter().take(3));
+        let block2: Vec<_> = pdu_crc
+            .flat_map(bits)
+            .enumerate()
+            .map(|(index, bit)| bit ^ whitening_bit(37, index as u32))
+            .collect();
+        let encoded = fec::conv_encode(&block2);
+        let block2 = if ci == 0 {
+            fec::pattern_map_s8(&encoded)
+        } else {
+            fec::pattern_map_s2(&encoded)
+        };
+        CODED_PREAMBLE_PATTERN
+            .into_iter()
+            .cycle()
+            .take(CODED_PREAMBLE_SYMBOLS)
+            .chain(fec::pattern_map_s8(&fec::conv_encode(&block1)))
+            .chain(block2)
+            .flat_map(|bit| std::iter::repeat_n(if bit == 1 { 1.0 } else { -1.0 }, BLE_SPS))
+            .collect()
+    }
+
+    #[test]
+    fn continuous_coded_scan_recovers_both_phases_after_a_bad_crc() {
+        let pdu = [0x02, 0x06, 1, 2, 3, 4, 5, 6];
+        for indicators in [[0, 1], [1, 0]] {
+            let mut demod = vec![0.0; 512];
+            demod.extend(coded_scan_fixture(&pdu, 0, false));
+            let mut starts = Vec::new();
+            for (index, ci) in indicators.into_iter().enumerate() {
+                demod.extend(std::iter::repeat_n(0.0, 513));
+                assert_eq!(demod.len() % 2, 1 - index);
+                starts.push(demod.len());
+                demod.extend(coded_scan_fixture(&pdu, ci, true));
+            }
+            let timestamp = Timespec {
+                tv_sec: 10,
+                tv_nsec: 999_900_000,
+            };
+            let packets = ble_coded_scan_packets(&demod, 2402, timestamp.clone(), &mut |_| None);
+            assert_eq!(packets.len(), 2);
+            for ((packet, start), ci) in packets.iter().zip(starts).zip(indicators) {
+                assert!(packet.crc_checked && packet.crc_valid);
+                assert_eq!(packet.data[4], ci);
+                assert_eq!(&packet.data[5..13], &pdu);
+                let expected = timestamp_with_sample_offset(&timestamp, start, BLE_SPS);
+                assert_eq!(packet.timestamp.tv_sec, expected.tv_sec);
+                assert!(packet.timestamp.tv_nsec.abs_diff(expected.tv_nsec) <= 500);
+            }
+        }
+    }
