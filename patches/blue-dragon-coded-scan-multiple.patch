+/// Decode CRC-valid LE Coded packets in a 2 MSps scan window.
+/// Try both sample phases, with up to eight alignments per preamble-sized
+/// region and 128 per window. Timestamps use the original window time base.
+pub fn ble_coded_scan_packets(
+    demod: &[f32],
+    freq: u32,
+    timestamp: Timespec,
+    crc_init_fn: &mut dyn FnMut(u32) -> Option<(u32, bool)>,
+) -> Vec<BlePacket> {
+    let minimum = (CODED_PREAMBLE_SYMBOLS + CODED_BLOCK1_SYMBOLS) * BLE_SPS;
+    if demod.len() < minimum {
+        return Vec::new();
+    }
+
+    let scores = coded_scan_preamble_scores(demod);
+    let limit = demod.len() - minimum + 1;
+    let strongest = (0..limit)
+        .filter(|&position| scores[position] >= 5)
+        .max_by_key(|&position| {
+            use std::cmp::Reverse;
+
+            (scores[position], Reverse(position % BLE_SPS), Reverse(position))
+        });
+    let Some(strongest) = strongest else {
+        return Vec::new();
+    };
+    // Reserve one attempt at the single-burst finder's strongest position
+    // if earlier preamble-like interference consumes the chronological budget.
+    let chronological_limit = CODED_SCAN_WINDOW_ATTEMPTS - 1;
+    let mut strongest_accounted = false;
+    let mut positions = Vec::with_capacity(CODED_PREAMBLE_SYMBOLS * BLE_SPS);
+    let mut packets = Vec::new();
+    let mut cursor = 0;
+    let mut attempts = 0;
+    while cursor < limit && attempts < chronological_limit {
+        let Some(distance) = scores[cursor..limit].iter().position(|&score| score >= 5) else {
+            break;
+        };
+        let start = cursor + distance;
+        let region_end = (start + CODED_PREAMBLE_SYMBOLS * BLE_SPS).min(limit);
+        positions.clear();
+        positions.extend((start..region_end).filter(|&i| scores[i] >= 5));
+        positions.sort_unstable_by_key(|&i| (std::cmp::Reverse(scores[i]), i));
+
+        cursor = region_end;
+        for &position in positions.iter().take(CODED_SCAN_LOCAL_ATTEMPTS) {
+            if attempts == chronological_limit {
+                break;
+            }
+            attempts += 1;
+            strongest_accounted |= position == strongest;
+            let Some((packet, end)) =
+                decode_coded_scan_at(demod, freq, &timestamp, crc_init_fn, position)
+            else {
+                continue;
+            };
+            packets.push(packet);
+            strongest_accounted |= (start..end).contains(&strongest);
+            cursor = cursor.max(end);
+            break;
+        }
+    }
+    if attempts == chronological_limit && !strongest_accounted {
+        if let Some((packet, _)) =
+            decode_coded_scan_at(demod, freq, &timestamp, crc_init_fn, strongest)
+        {
+            packets.push(packet);
+            packets.sort_by_key(|packet| (packet.timestamp.tv_sec, packet.timestamp.tv_nsec));
+        }
+    }
+    packets
+}
