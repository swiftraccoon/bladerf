+const CODED_SCAN_LOCAL_ATTEMPTS: usize = 8;
+const CODED_SCAN_WINDOW_ATTEMPTS: usize = 128;
+const CODED_MAX_PDU_BYTES: usize = 251;
+
+fn coded_scan_preamble_scores(demod: &[f32]) -> Vec<u8> {
+    let dc = coded_preamble_dc_offset(demod);
+    let pattern = CODED_PREAMBLE_PATTERN
+        .into_iter()
+        .fold(0u8, |word, bit| (word << 1) | bit);
+    let mut scores = vec![0; demod.len()];
+    let pattern_samples = CODED_PREAMBLE_PATTERN.len() * BLE_SPS;
+    for phase in 0..BLE_SPS {
+        let mut word = 0u8;
+        for (symbol, samples) in demod[phase..].chunks_exact(BLE_SPS).enumerate() {
+            let bit = samples.iter().sum::<f32>() / BLE_SPS as f32 - dc > 0.0;
+            word = (word << 1) | u8::from(bit);
+            if symbol + 1 >= CODED_PREAMBLE_PATTERN.len() {
+                let errors = (word ^ pattern).count_ones();
+                let start = phase + (symbol + 1) * BLE_SPS - pattern_samples;
+                scores[start] = u8::from(errors <= 1 || errors >= 7);
+            }
+        }
+    }
+    // Count consecutive matches one pattern apart, as in the burst finder.
+    for start in (0..scores.len().saturating_sub(pattern_samples)).rev() {
+        if scores[start] != 0 {
+            scores[start] = (1 + scores[start + pattern_samples]).min(CODED_PREAMBLE_REPS as u8);
+        }
+    }
+    scores
+}
