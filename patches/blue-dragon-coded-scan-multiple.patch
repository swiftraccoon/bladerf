+fn coded_preamble_dc_offset(demod: &[f32]) -> f32 {
+    let n = 200.min(demod.len());
+    let mut sorted = demod[..n].to_vec();
+    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    sorted[n / 2]
+}
