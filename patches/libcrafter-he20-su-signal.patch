+//! HE20 SU SIG-A observation after legacy OFDM acquisition.
+
+use super::{
+    signal::{decode_bcc, decode_signal, SignalInfo},
+    sync::{fft64, Acquisition},
+};
+use crate::radio::{codec::PhyDiagnostic, wifi::ht::signal_crc, ComplexSample};
+
+const SYMBOL_SAMPLES: usize = 80;
+const REPEATED_HEADER_SAMPLES: usize = 2 * SYMBOL_SAMPLES;
+const PREFIX_SAMPLES: usize = 4 * SYMBOL_SAMPLES;
+
+/// The observer owns one bounded prefix buffer outside the DATA reservations.
+#[derive(Default)]
+pub(super) struct Observer {
+    pending: Option<Prefix>,
+}
+
+struct Prefix {
+    acquisition: Acquisition,
+    samples: [ComplexSample; PREFIX_SAMPLES],
+    count: usize,
+    legacy: Option<SignalInfo>,
+}
+
+impl Observer {
+    pub(super) fn start(&mut self, acquisition: &Acquisition) {
+        if self.pending.is_none() {
+            self.pending = Some(Prefix {
+                acquisition: acquisition.clone(),
+                samples: [ComplexSample::ZERO; PREFIX_SAMPLES],
+                count: 0,
+                legacy: None,
+            });
+        }
+    }
+
+    pub(super) fn reset(&mut self) {
+        self.pending = None;
+    }
+
+    pub(super) fn push(&mut self, sample: ComplexSample) -> Option<PhyDiagnostic> {
+        let prefix = self.pending.as_mut()?;
+        prefix.samples[prefix.count] = sample;
+        prefix.count += 1;
+        match prefix.count {
+            SYMBOL_SAMPLES => {
+                prefix.legacy =
+                    decode_signal(&prefix.samples[..SYMBOL_SAMPLES], &prefix.acquisition, 4095)
+                        .ok()
+                        .filter(|signal| {
+                            signal.rate_bps == 6_000_000 && signal.psdu_bytes % 3 == 1
+                        });
+                if prefix.legacy.is_none() {
+                    self.reset();
+                }
+                None
+            }
+            REPEATED_HEADER_SAMPLES => {
+                let mut repeated = prefix.acquisition.clone();
+                // This position was already checked by the L-SIG decoder.
+                let legacy = prefix.legacy?;
+                repeated.signal_start = legacy.data_start;
+                let signal = decode_signal(
+                    &prefix.samples[SYMBOL_SAMPLES..REPEATED_HEADER_SAMPLES],
+                    &repeated,
+                    4095,
+                );
+                if !signal.is_ok_and(|signal| {
+                    signal.rate_bps == 6_000_000
+                        && prefix
+                            .legacy
+                            .is_some_and(|legacy| signal.psdu_bytes == legacy.psdu_bytes)
+                }) {
+                    self.reset();
+                }
+                None
+            }
+            PREFIX_SAMPLES => {
+                let prefix = self.pending.take()?;
+                decode_prefix(&prefix.samples, &prefix.acquisition)
+            }
+            _ => None,
+        }
+    }
+}
+
+/// Phase-correct one signaling symbol using the legacy long-training estimate.
+fn corrected_bins(
+    samples: &[ComplexSample; PREFIX_SAMPLES],
+    symbol: usize,
+    acquisition: &Acquisition,
+) -> Option<[ComplexSample; 64]> {
+    let offset = symbol * SYMBOL_SAMPLES + 16;
+    let elapsed = acquisition
+        .signal_start
+        .checked_add(offset as u64)?
+        .checked_sub(acquisition.phase_origin)?;
+    let bins = fft64(std::array::from_fn(|index| {
+        samples[offset + index].mul(ComplexSample::rotation(
+            -acquisition.frequency_rad * (elapsed + index as u64) as f32,
+        ))
+    }));
+    let mut pilot = ComplexSample::ZERO;
+    for (tone, sign) in [(43, 1.), (57, 1.), (7, 1.), (21, -1.)] {
+        pilot = pilot.add(bins[tone].mul(acquisition.channel[tone].conj()).scale(sign));
+    }
+    if !pilot.power().is_finite() || pilot.power() < 1e-12 {
+        return None;
+    }
+    let correction = ComplexSample::rotation(-pilot.phase());
+    Some(bins.map(|bin| bin.mul(correction)))
+}
+
+fn decode_prefix(
+    samples: &[ComplexSample; PREFIX_SAMPLES],
+    acquisition: &Acquisition,
+) -> Option<PhyDiagnostic> {
+    // Follow libcrafter 00f1fed7 HE SU SIG-A demodulation. L-SIG and RL-SIG
+    // supply channel estimates for the four tones absent from legacy L-LTF.
+    let legacy = corrected_bins(samples, 0, acquisition)?;
+    let repeated = corrected_bins(samples, 1, acquisition)?;
+    let mut channel = acquisition.channel;
+    for (tone, sign) in [(36, -1.), (37, -1.), (27, -1.), (28, 1.)] {
+        channel[tone] = legacy[tone].add(repeated[tone]).scale(0.5 * sign);
+    }
+    let mut metrics = [0.; 104];
+    for symbol in 0..2 {
+        let observed = corrected_bins(samples, symbol + 2, acquisition)?;
+        let (mut real, mut quadrature) = (0., 0.);
+        for (index, tone) in (-28i32..=28)
+            .filter(|tone| ![-21, -7, 0, 7, 21].contains(tone))
+            .enumerate()
+        {
+            let bin = tone.rem_euclid(64) as usize;
+            let weighted = observed[bin].mul(channel[bin].conj());
+            metrics[symbol * 52 + index] = weighted.i;
+            real += weighted.i * weighted.i;
+            quadrature += weighted.q * weighted.q;
+        }
+        if !real.is_finite() || !quadrature.is_finite() || real < 1e-12 || real <= 4. * quadrature {
+            return None;
+        }
+    }
+    let scale = metrics.iter().map(|metric| metric.abs()).fold(0., f32::max);
+    let coded: [f32; 104] = std::array::from_fn(|index| {
+        let bit = index % 52;
+        metrics[52 * (index / 52) + 4 * (bit % 13) + bit / 13] / scale
+    });
+    let pairs: [[f32; 2]; 52] =
+        std::array::from_fn(|index| [coded[2 * index], coded[2 * index + 1]]);
+    signal_fields(&decode_bcc(&pairs), acquisition.preamble_start)
+}
+
+/// HE SU fields and integrity checks follow IEEE 802.11ax-2021 Tables 27-18/19/35.
+fn signal_fields(bits: &[u8; 52], preamble_sample_index: u64) -> Option<PhyDiagnostic> {
+    let expected_crc = signal_crc(&bits[..42]) >> 4;
+    let received_crc = bits[42..46].iter().fold(0, |crc, bit| (crc << 1) | bit);
+    if expected_crc != received_crc || bits[46..].iter().any(|bit| *bit != 0) {
+        return None;
+    }
+    let field = |start: usize, length: usize| {
+        bits[start..start + length]
+            .iter()
+            .enumerate()
+            .fold(0, |value, (index, bit)| value | (bit << index))
+    };
+    let mcs = field(3, 4);
+    let ldpc = bits[33] != 0;
+    if bits[0] != 1
+        || bits[14] != 1
+        || bits[40] != 1
+        || (!ldpc && bits[34] != 1)
+        || mcs > 11
+        || field(19, 2) != 0
+    {
+        return None;
+    }
+    let gi = usize::from(field(21, 2));
+    let guard_interval_ns = if bits[7] != 0 && bits[35] != 0 {
+        (gi == 3).then_some(800)?
+    } else {
+        [800, 800, 1600, 3200][gi]
+    };
+    Some(PhyDiagnostic::HeSuSignal {
+        preamble_sample_index,
+        mcs,
+        space_time_streams: field(23, if bits[41] != 0 { 2 } else { 3 }) + 1,
+        ldpc,
+        guard_interval_ns,
+        bss_color: field(8, 6),
+    })
+}
