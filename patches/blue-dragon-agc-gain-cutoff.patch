+fn rssi_db_for_gain(gain: f32) -> f32 {
+    -20.0 * gain.log10()
+}
+
+fn gain_cutoff(threshold_db: f32) -> f32 {
+    // Positive f32 bit patterns sort by gain. Find the first gain that fails
+    // the rounded RSSI comparison, using the value past MAX_GAIN if all pass.
+    let mut lower = MIN_GAIN.to_bits();
+    let mut upper = MAX_GAIN.to_bits() + 1;
+    while lower < upper {
+        let middle = lower + (upper - lower) / 2;
+        if rssi_db_for_gain(f32::from_bits(middle)) > threshold_db {
+            lower = middle + 1;
+        } else {
+            upper = middle;
+        }
+    }
+    f32::from_bits(lower)
 }

