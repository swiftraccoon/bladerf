+
+    #[test]
+    fn gain_cutoff_preserves_rounded_rssi_comparisons() {
+        let gain_bits = [MIN_GAIN.to_bits(), 1.0f32.to_bits(), MAX_GAIN.to_bits()];
+        let gain_range = MAX_GAIN.to_bits() - MIN_GAIN.to_bits();
+        let mut seed = 1u32;
+        for bits in gain_bits.into_iter().chain((0..4096).map(|_| {
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            MIN_GAIN.to_bits() + seed % gain_range
+        })) {
+            let rssi = rssi_db_for_gain(f32::from_bits(bits));
+            for threshold_db in [rssi.next_down(), rssi, rssi.next_up()] {
+                let cutoff = gain_cutoff(threshold_db);
+                let first = bits.saturating_sub(16).max(MIN_GAIN.to_bits());
+                let last = (bits + 16).min(MAX_GAIN.to_bits());
+                for neighbor in first..=last {
+                    let gain = f32::from_bits(neighbor);
+                    assert_eq!(
+                        gain < cutoff,
+                        rssi_db_for_gain(gain) > threshold_db,
+                        "gain={gain:?}, threshold={threshold_db:?}",
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn updating_squelch_threshold_preserves_rise_and_timeout() {
+        let silence = Complex32::new(0.0, 0.0);
+        let mut agc = Agc::new(0.0, f32::NAN, 1);
+        assert_eq!(agc.execute(silence).1, SquelchState::SignalLo);
+
+        let initial_rssi = agc.rssi_db();
+        agc.set_squelch_threshold(initial_rssi);
+        assert_eq!(agc.execute(silence).1, SquelchState::SignalLo);
+        agc.set_squelch_threshold(initial_rssi.next_down());
+        assert_eq!(agc.execute(silence).1, SquelchState::Rise);
+        assert_eq!(agc.execute(silence).1, SquelchState::SignalHi);
+
+        agc.set_squelch_threshold(f32::INFINITY);
+        assert_eq!(agc.execute(silence).1, SquelchState::Timeout);
+        agc.set_squelch_threshold(f32::NEG_INFINITY);
+        assert_eq!(agc.execute(silence).1, SquelchState::Rise);
+
+        agc.gain = f32::NAN;
+        assert!(agc.rssi_db().is_nan());
+        assert_eq!(agc.execute(silence).1, SquelchState::SignalLo);
+    }
