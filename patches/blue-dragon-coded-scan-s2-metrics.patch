+fn coded_block2_retry_extent(payload_length: usize) -> Option<(usize, usize)> {
+    if payload_length > CODED_MAX_PDU_BYTES {
+        return None;
+    }
+    let packet_bytes = 2 + payload_length + 3;
+    // The header bounds the trellis to PDU, CRC and three TERM2 bits.
+    let coded_metric_count = 2 * (packet_bytes * 8 + 3);
+    Some((packet_bytes, coded_metric_count))
+}
