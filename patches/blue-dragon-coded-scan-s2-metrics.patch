+fn retry_clipped_s2_coded_block2(
+    soft_coded: &mut [f32],
+    channel: u32,
+    payload_length: usize,
+    crc_init: u32,
+) -> Option<Vec<u8>> {
+    // S=2 passes each averaged FM symbol directly to the trellis, with
+    // polarity inverted. Limit the influence of phase outliers in those units.
+    const METRIC_LIMIT: f32 = 0.35;
+    let (_, coded_metric_count) = coded_block2_retry_extent(payload_length)?;
+    let metrics = soft_coded.get_mut(..coded_metric_count)?;
+    let mut clipped = false;
+    for metric in metrics.iter_mut() {
+        if !metric.is_finite() {
+            return None;
+        }
+        if metric.abs() > METRIC_LIMIT {
+            *metric = METRIC_LIMIT.copysign(*metric);
+            clipped = true;
+        }
+    }
+    if !clipped {
+        return None;
+    }
+    retry_terminated_coded_block2(metrics, channel, payload_length, crc_init)
+}
