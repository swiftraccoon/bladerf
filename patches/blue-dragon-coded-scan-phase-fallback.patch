+/// Search raw preamble candidates with tapered S=2 advertising payload metrics.
+/// Call this after ordinary file replay finds no packet in the window.
+pub fn ble_coded_replay_packets_with_phase_retry(
+    demod: &[f32],
+    freq: u32,
+    timestamp: Timespec,
+    connections: &mut CodedScanConnections,
+) -> Vec<BlePacket> {
+    scan_coded_packets(
+        demod,
+        freq,
+        timestamp,
+        &mut CodedScanContext::PhaseReplay(connections),
+    )
+}
+
 enum CodedScanContext<'a> {
     Lookup(&'a mut dyn FnMut(u32) -> Option<(u32, bool)>),
     Replay(&'a mut CodedScanConnections),
+    PhaseReplay(&'a mut CodedScanConnections),
+}
+
+impl CodedScanContext<'_> {
+    fn observe_request(&mut self, packet: &BlePacket, timestamp: &Timespec, end: usize) {
+        if packet.is_data {
+            return;
+        }
+        if let Self::Replay(connections) | Self::PhaseReplay(connections) = self {
+            let completed = timestamp_with_sample_offset(timestamp, end, BLE_SPS);
+            connections.observe_request(packet, &completed);
+        }
+    }
 }
 
