 use num_complex::Complex32;
 
+const CODED_FILTER_HALF_TAPS: usize = 16;
+const CODED_FILTER_TAPS: usize = 2 * CODED_FILTER_HALF_TAPS + 1;
+
+fn coded_filter_taps() -> [f32; CODED_FILTER_TAPS] {
+    const CUTOFF: f32 = 0.45 / 2.0; // 450 kHz at 2 MSps.
+    let mut taps = std::array::from_fn(|i| {
+        let x = i as f32 - CODED_FILTER_HALF_TAPS as f32;
+        let phase = std::f32::consts::TAU * CUTOFF * x;
+        let sinc = if i == CODED_FILTER_HALF_TAPS {
+            1.0
+        } else {
+            phase.sin() / phase
+        };
+        let window = 0.54 + 0.46 * (std::f32::consts::PI * x / CODED_FILTER_HALF_TAPS as f32).cos();
+        2.0 * CUTOFF * sinc * window
+    });
+    let gain = taps.iter().sum::<f32>();
+    for tap in &mut taps {
+        *tap /= gain;
+    }
+    taps
+}
+
+/// Narrow a 2 MSps LE Coded window with a centered 450 kHz low-pass filter.
+/// Zero padding keeps one output per input sample on the original time grid.
+pub fn narrow_coded_iq(samples: &[Complex32]) -> Vec<Complex32> {
+    static TAPS: std::sync::OnceLock<[f32; CODED_FILTER_TAPS]> = std::sync::OnceLock::new();
+    let taps = TAPS.get_or_init(coded_filter_taps);
+    let mut padded = vec![Complex32::default(); samples.len() + 2 * CODED_FILTER_HALF_TAPS];
+    padded[CODED_FILTER_HALF_TAPS..CODED_FILTER_HALF_TAPS + samples.len()].copy_from_slice(samples);
+    padded
+        .windows(taps.len())
+        .map(|window| {
+            window
+                .iter()
+                .zip(taps)
+                .map(|(sample, tap)| *sample * tap)
+                .sum()
+        })
+        .collect()
+}
