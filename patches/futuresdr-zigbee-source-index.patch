+use anyhow::Context;
 use futuresdr::runtime::dev::prelude::*;
 
+#[derive(Default)]
+struct SourceIndex {
+    consumed: u64,
+    previous_horizon: Option<u64>,
+}
+
+impl SourceIndex {
+    fn anchor(&mut self, required_through: usize) -> Result<Option<u64>> {
+        let horizon = self
+            .consumed
+            .checked_add(u64::try_from(required_through)?)
+            .context("clock input horizon overflow")?;
+        let follows_nominal_step = self
+            .previous_horizon
+            .and_then(|previous| previous.checked_add(2))
+            == Some(horizon);
+        self.previous_horizon = Some(horizon);
+        Ok((!follows_nominal_step).then_some(horizon))
+    }
+}
