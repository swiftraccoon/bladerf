+}
+
+impl SourceIndex {
+    fn observe(&mut self, anchor: Option<u64>) -> Result<u64> {
+        let horizon = match anchor {
+            Some(horizon) => {
+                ensure!(
+                    self.previous_horizon
+                        .is_none_or(|previous| horizon >= previous),
+                    "clock input horizon moved backwards"
+                );
