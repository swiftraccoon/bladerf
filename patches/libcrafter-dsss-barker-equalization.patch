+#[derive(Clone, Debug)]
+enum PayloadChannel {
+    Barker {
+        projection: BarkerProjection,
+        previous_symbol: ComplexSample,
+    },
+    Cck(ChannelModel),
+}
+
+#[derive(Clone, Debug)]
+struct BarkerProjection {
+    weights: [ComplexSample; 18],
+}
+
+impl BarkerProjection {
+    fn new((taps, noise): ChannelModel, frequency_rad: f32) -> Option<Self> {
+        let mut weights = [ComplexSample::ZERO; 18];
+        let mut energy = 0.;
+        for (index, weight) in weights.iter_mut().enumerate() {
+            // Adjacent header or payload symbols can mix into the outer chips.
+            // Restrict the projection to the trained interior of this symbol.
+            let chip = 1 + index / 2;
+            let phase = index % 2;
+            let mut expected = ComplexSample::ZERO;
+            for tap in 0..3 {
+                expected = expected.add(taps[3 * phase + tap].scale(BARKER[chip + tap - 1]));
+            }
+            let inverse_noise = 1. / noise[phase];
+            energy += expected.power() * inverse_noise;
+            let rotation =
+                ComplexSample::rotation(-frequency_rad * (Self::offset(index) as f32 - 10.));
+            *weight = expected.conj().mul(rotation).scale(inverse_noise);
+        }
+        if !energy.is_finite() || energy <= 1e-12 {
+            return None;
+        }
+        for weight in &mut weights {
+            *weight = weight.scale(energy.recip());
+        }
+        Some(Self { weights })
+    }
+
+    fn offset(index: usize) -> f64 {
+        (1.25 + index as f64 * 0.5) * 20. / 11.
+    }
+
+    fn symbol(&self, samples: &Samples, start: f64) -> Option<ComplexSample> {
+        let mut sum = ComplexSample::ZERO;
+        for (index, weight) in self.weights.iter().enumerate() {
+            let sample = samples.at(start + Self::offset(index))?;
+            sum = sum.add(sample.mul(*weight));
+        }
+        Some(sum)
+    }
+}
