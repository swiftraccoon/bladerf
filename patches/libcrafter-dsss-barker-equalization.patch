+#[test]
+fn radio_dsss_barker_recovers_payload_interference() {
+    let index = include_str!("fixtures/iq/dsss-index.tsv");
+    let truth = index
+        .lines()
+        .find(|line| line.starts_with("dsss-10-long-impaired-64\t"))
+        .unwrap();
+    let expected = bytes(truth.split('\t').nth(4).unwrap());
+    let input = include_bytes!("fixtures/iq/dsss-10-long-impaired-64.cs8");
+    let mut noise_state = 12_345u32;
+    let stressed: Vec<u8> = input
+        .iter()
+        .enumerate()
+        .map(|(component, &value)| {
+            noise_state = noise_state
+                .wrapping_mul(1_664_525)
+                .wrapping_add(1_013_904_223);
+            // Start interference 100 samples into the payload to preserve PLCP training.
+            let noise = if component / 2 >= 3_978 {
+                ((i64::from(noise_state) - (1 << 31)) * 104) / (1 << 31)
+            } else {
+                0
+            };
+            i8::try_from((i64::from(value as i8) + noise) * 5 / 8)
+                .expect("interference fixture must stay within CS8 range") as u8
+        })
+        .collect();
+    for width in [137, 100_000] {
+        let mut decoder = DsssCckDecoder::new();
+        let mut frames = Vec::new();
+        for (part, samples) in stressed.chunks(width * 2).enumerate() {
+            frames.extend(
+                decoder
+                    .consume(IqEvent::Chunk(chunk(
+                        samples,
+                        part as u64,
+                        (part * width) as u64,
+                    )))
+                    .unwrap()
+                    .frames,
+            );
+        }
+        assert_eq!(frames.len(), 1, "{:?}", decoder.stats());
+        assert_eq!(frames[0].bytes, expected);
+        assert_eq!(frames[0].integrity, FrameIntegrity::ValidFcs);
+        assert_eq!(decoder.stats().invalid_fcs, 0);
+    }
+}
