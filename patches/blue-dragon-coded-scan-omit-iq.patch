+#[derive(Default)]
+struct CodedScanCoverage {
+    selected_frequency_mhz: u32,
+    windows: u64,
+    first_samples: usize,
+    last_start: u64,
+    last_samples: usize,
+}
+
+impl CodedScanCoverage {
+    fn observe(
+        &mut self,
+        frequency_mhz: u32,
+        timestamp: &Timespec,
+        samples: usize,
+    ) -> Result<(), String> {
+        let start = timestamp.tv_sec
+            .checked_mul(1_000_000_000 / CHANNEL_SAMPLE_PERIOD_NS)
+            .and_then(|seconds| seconds.checked_add(timestamp.tv_nsec / CHANNEL_SAMPLE_PERIOD_NS))
+            .ok_or("coded scan timestamp exceeds channel sample range")?;
+        let (expected_start, expected_samples) = if self.windows == 0 {
+            (0, SCAN_STEP)
+        } else {
+            let offset = self.windows
+                .checked_mul(SCAN_STEP as u64)
+                .ok_or("coded scan window count exceeds channel sample range")?;
+            (offset - (SCAN_WINDOW - SCAN_STEP) as u64, SCAN_WINDOW)
+        };
+        if frequency_mhz != self.selected_frequency_mhz
+            || timestamp.tv_nsec >= 1_000_000_000
+            || timestamp.tv_nsec % CHANNEL_SAMPLE_PERIOD_NS != 0
+            || start != expected_start
+            || samples != expected_samples
+        {
+            return Err(format!(
+                "unexpected coded scan window {}: {} MHz at sample {} with {} samples",
+                self.windows, frequency_mhz, start, samples,
+            ));
+        }
+        if self.windows == 0 {
+            self.first_samples = samples;
+        }
+        self.windows += 1;
+        self.last_start = start;
+        self.last_samples = samples;
+        Ok(())
+    }
+
+    fn finish(self, channel_samples: u64) -> Result<(), String> {
+        let expected_windows = channel_samples / SCAN_STEP as u64;
+        if self.windows != expected_windows {
+            return Err(format!(
+                "completed {} coded scan windows, expected {}",
+                self.windows, expected_windows,
+            ));
+        }
+        // The first complete window starts at zero on the file's time origin.
+        eprintln!(
+            "coded scan coverage v1: {} {} 0 {} {} {}",
+            self.selected_frequency_mhz, self.windows, self.first_samples,
+            self.last_start, self.last_samples,
+        );
+        Ok(())
+    }
+}
