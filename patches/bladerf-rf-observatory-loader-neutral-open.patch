diff --git a/host/libraries/libbladeRF/CMakeLists.txt b/host/libraries/libbladeRF/CMakeLists.txt
index 009ab65f..ca3f1679 100644
--- a/host/libraries/libbladeRF/CMakeLists.txt
+++ b/host/libraries/libbladeRF/CMakeLists.txt
@@ -87,6 +87,23 @@ option(ENABLE_USB_DEV_RESET_ON_OPEN
        ${BLADERF_OS_LINUX}
 )
 
+option(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN
+       "Open only a bladeRF 2 at firmware state without inspecting, loading, or initializing its current FPGA."
+       OFF
+)
+
+if(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN AND ENABLE_USB_DEV_RESET_ON_OPEN)
+    message(FATAL_ERROR
+        "ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN requires ENABLE_USB_DEV_RESET_ON_OPEN=OFF"
+    )
+endif()
+
+if(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN AND ENABLE_LIBBLADERF_BLADERF2_CONFIG_NEUTRAL_OPEN)
+    message(FATAL_ERROR
+        "bladeRF 2 loader-neutral and configuration-neutral open modes are mutually exclusive"
+    )
+endif()
+
 option(ENABLE_RFIC_TIMING_CALIBRATION
        "Perform timing calibration on the RFIC digital interface during initialization. This is only implemented on AD936x-based hardware."
        OFF
@@ -286,6 +303,10 @@ if(ENABLE_USB_DEV_RESET_ON_OPEN)
     add_definitions(-DENABLE_USB_DEV_RESET_ON_OPEN=1)
 endif()
 
+if(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN)
+    add_definitions(-DENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN=1)
+endif()
+
 if(BUILD_AD936X)
     set(LIBBLADERF_LIBS ${LIBBLADERF_LIBS} ad936x)
 endif(BUILD_AD936X)
diff --git a/host/libraries/libbladeRF/include/libbladeRF.h b/host/libraries/libbladeRF/include/libbladeRF.h
index 63cb2385..d7dab27b 100644
--- a/host/libraries/libbladeRF/include/libbladeRF.h
+++ b/host/libraries/libbladeRF/include/libbladeRF.h
@@ -53,6 +53,11 @@
  */
 #define LIBBLADERF_API_VERSION (0x02060000)
 
+/** Versioned marker returned by
+ * bladerf_get_bladerf2_loader_neutral_open_marker() when the specialized open
+ * contract is enabled. The value encodes "B2L" followed by revision 1. */
+#define BLADERF2_LOADER_NEUTRAL_OPEN_MARKER_V1 UINT32_C(0x42324c01)
+
 #ifdef __cplusplus
 extern "C" {
 #else
@@ -4467,6 +4472,25 @@ void CALL_CONV bladerf_log_set_verbosity(bladerf_log_level level);
 API_EXPORT
 void CALL_CONV bladerf_version(struct bladerf_version *version);
 
+/**
+ * Query this patched library's specialized bladeRF 2 loader open contract.
+ *
+ * A return value of ::BLADERF2_LOADER_NEUTRAL_OPEN_MARKER_V1 means
+ * bladerf_open() accepts a bladeRF 2 whether its FPGA is configured or not,
+ * leaves board state at firmware-loaded, and skips automatic FPGA loading,
+ * current-FPGA protocol/version access, board/RFIC initialization,
+ * configuration-file processing and scheduled-retune cancellation. It was
+ * built without USB reset-on-open. The USB backend still claims the interface
+ * and selects transport alternate settings. Explicit bladerf_load_fpga() calls
+ * load the supplied RAM image and then perform normal board/RFIC initialization.
+ * Other explicit APIs can also change the device.
+ *
+ * @return ::BLADERF2_LOADER_NEUTRAL_OPEN_MARKER_V1 when enabled, or
+ *         zero in the default build.
+ */
+API_EXPORT
+uint32_t CALL_CONV bladerf_get_bladerf2_loader_neutral_open_marker(void);
+
 /** @} (End of FN_LIBRARY_VERSION) */
 
 /**
