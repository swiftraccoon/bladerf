      * libbladeRF. Specifically, this has proven to be a problem with pre-v0.0.1
      * FPGA images, as they do not provide version readback functionality.
      */
+#if !defined(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN)
     if (getenv("BLADERF_FORCE_NO_FPGA_PRESENT")) {
         log_debug("Reporting no FPGA present - "
                   "BLADERF_FORCE_NO_FPGA_PRESENT is set.\n");
         return 0;
     }
+#endif
 
     status = vendor_cmd_int(dev, BLADE_USB_CMD_QUERY_FPGA_STATUS,
                             USB_DIR_DEVICE_TO_HOST, &result);
@@ -463,7 +465,11 @@ static int usb_load_fpga(struct bladerf *dev, const uint8_t *image, size_t image
         log_debug("Failed to determine if FPGA is loaded: %s\n",
                   bladerf_strerror(status));
         return status;
+#if defined(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN)
+    } else if (status != 1) {
+#else
     } else if (wait_count == 0 && status != 0) {
+#endif
         log_debug("Timeout while waiting for FPGA configuration status\n");
         return BLADERF_ERR_TIMEOUT;
     }
diff --git a/host/libraries/libbladeRF/src/bladerf.c b/host/libraries/libbladeRF/src/bladerf.c
index d68595f4..3a846420 100644
--- a/host/libraries/libbladeRF/src/bladerf.c
+++ b/host/libraries/libbladeRF/src/bladerf.c
@@ -164,13 +164,15 @@ int bladerf_open_with_devinfo(struct bladerf **opened_device,
         return status;
     }
 
-    /* Load configuration file */
+    /* The specialized bladeRF 2 loader contract never processes bladeRF.conf. */
+#if !defined(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN)
     status = config_load_options_file(dev);
 
     if (status < 0) {
         bladerf_close(dev);
         return status;
     }
+#endif
 
     *opened_device = dev;
 
@@ -530,6 +532,15 @@ void bladerf_version(struct bladerf_version *version)
     version->describe = LIBBLADERF_VERSION;
 }
 
+uint32_t bladerf_get_bladerf2_loader_neutral_open_marker(void)
+{
+#if defined(ENABLE_LIBBLADERF_BLADERF2_LOADER_NEUTRAL_OPEN)
+    return BLADERF2_LOADER_NEUTRAL_OPEN_MARKER_V1;
+#else
+    return 0;
+#endif
+}
+
