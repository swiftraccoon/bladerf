+    #[test]
+    fn test_ble_burst_prefers_complete_crc_valid_advertising() {
+        let mut pdu = [0_u8; 33];
+        pdu[..12].copy_from_slice(&[0x42, 31, 0, 5, 4, 3, 2, 0xc1, 24, 0xff, 0x99, 4]);
+        // With six retained preamble bits, the offset-8 candidate reports a
+        // larger payload that fits the burst tail better than the real frame.
+        let mut bits = vec![0, 1, 0, 1, 0, 1];
+        bits.extend((0..32).map(|bit| ((BLE_ADV_AA >> bit) & 1) as u8));
+        let body = pdu.into_iter().chain([0x87, 0xf2, 0x47]); // Independent CRC-24/BLE.
+        bits.extend(
+            body.flat_map(|byte| (0..8).map(move |bit| (byte >> bit) & 1))
+                .enumerate()
+                .map(|(index, bit)| bit ^ whitening_bit(37, index as u32)),
+        );
+        let complete = bits.len();
+        let decode = |bits: &[u8], check_crc| {
+            ble_burst(
+                bits,
+                2402,
+                crate::Timespec { tv_sec: 0, tv_nsec: 0 },
+                check_crc,
+                |_| None,
+            )
+        };
+
+        bits.resize(complete + 19, 0);
+        let advertising = decode(&bits, true).unwrap();
+        assert_eq!(advertising.aa, BLE_ADV_AA);
+        assert!(!advertising.is_data);
+        assert!(advertising.crc_checked && advertising.crc_valid);
+        assert_eq!(advertising.data.len(), 40);
+        assert_eq!(&advertising.data[4..37], &pdu);
+        assert_eq!(&advertising.data[37..], &[0x87, 0xf2, 0x47]);
+
+        let unchecked = decode(&bits, false).unwrap();
+        assert_eq!(unchecked.aa, 0xe3a2_6fb5);
+        assert!(unchecked.is_data && !unchecked.crc_checked && !unchecked.crc_valid);
+
+        // The missing CRC bit would dewhiten to zero if padded.
+        assert!(decode(&bits[..complete - 1], true).is_none());
+        assert!(decode(&bits[..complete], true).unwrap().crc_valid);
+        bits[complete - 1] ^= 1;
+        let fallback = decode(&bits, true).unwrap();
+        assert_eq!(fallback.aa, unchecked.aa);
+        assert!(fallback.is_data && !fallback.crc_checked && !fallback.crc_valid);
+
+        bits.truncate(complete + 4);
+        let bad_advertising = decode(&bits, true).unwrap();
+        assert_eq!(bad_advertising.aa, BLE_ADV_AA);
+        assert!(bad_advertising.crc_checked && !bad_advertising.crc_valid);
+    }
