 // BLADERF_FEATURE_OVERSAMPLE = 1
 const BLADERF_FEATURE_OVERSAMPLE: c_uint = 1;
 
+/// Check setup on an exclusively owned open handle, closing it on failure.
+///
+/// Safety: `dev` must be the live handle used by the operation producing `status`.
+/// An error consumes that handle; the caller must immediately propagate it.
+unsafe fn check_rx_setup(
+    dev: *mut BladerfDevice,
+    status: c_int,
+    operation: &str,
+) -> Result<(), String> {
+    if status != 0 {
+        bladerf_close(dev);
+        return Err(format!("{} failed: {}", operation, status));
+    }
+    Ok(())
+}
+
+/// Configure an RX channel before streaming; every failed call closes the handle.
+///
+/// Safety: the caller owns the live `dev` handle exclusively and propagates errors
+/// immediately, without subsequently accessing or closing a consumed handle.
+unsafe fn configure_rx(
+    dev: *mut BladerfDevice,
+    channel: c_int,
+    sample_rate: u32,
+    center_freq: u64,
+    gain: i32,
+) -> Result<bool, String> {
+    if channel != BLADERF_CHANNEL_RX_0 && channel != BLADERF_CHANNEL_RX_1 {
+        bladerf_close(dev);
+        return Err("only bladeRF RX channels are supported".to_string());
+    }
+    let use_sc8 = sample_rate > 61_440_000;
+    check_rx_setup(
+        dev,
+        bladerf_enable_feature(dev, BLADERF_FEATURE_OVERSAMPLE, use_sc8),
+        "bladerf_enable_feature",
+    )?;
+    check_rx_setup(
+        dev,
+        bladerf_set_bandwidth(dev, channel, sample_rate.min(56_000_000), ptr::null_mut()),
+        "bladerf_set_bandwidth",
+    )?;
+    check_rx_setup(
+        dev,
+        bladerf_set_frequency(dev, channel, center_freq),
+        "bladerf_set_frequency",
+    )?;
+    let mode = if gain < 0 {
+        BLADERF_GAIN_DEFAULT
+    } else {
+        BLADERF_GAIN_MGC
+    };
+    check_rx_setup(
+        dev,
+        bladerf_set_gain_mode(dev, channel, mode),
+        "bladerf_set_gain_mode",
+    )?;
+    if gain >= 0 {
+        check_rx_setup(
+            dev,
+            bladerf_set_gain(dev, channel, gain),
+            "bladerf_set_gain",
+        )?;
+    }
+    Ok(use_sc8)
+}
+
+/// Require the configured rate to match the decoder's sample-time assumptions.
+/// Safety: the caller exclusively owns `dev` and propagates errors immediately.
+unsafe fn configure_rx_rate(
+    dev: *mut BladerfDevice,
+    channel: c_int,
+    requested: u32,
+) -> Result<(), String> {
+    let mut actual = 0;
+    check_rx_setup(
+        dev,
+        bladerf_set_sample_rate(dev, channel, requested, &mut actual),
+        "bladerf_set_sample_rate",
+    )?;
+    if actual != requested {
+        bladerf_close(dev);
+        return Err(format!(
+            "bladeRF sample rate mismatch: requested {}, actual {}",
+            requested, actual
+        ));
+    }
+    Ok(())
+}
