+#[derive(Clone, Copy)]
+pub(crate) enum FileCodedScan {
+    Disabled,
+    Primary,
+    Secondary(u32),
+}
+
+impl FileCodedScan {
+    fn selects(self, freq_mhz: u32) -> bool {
+        match self {
+            Self::Disabled => false,
+            Self::Primary => is_primary_advertising_frequency(freq_mhz),
+            Self::Secondary(selected) => freq_mhz == selected,
+        }
+    }
+
+    fn deduplicates(self, freq_mhz: u32) -> bool {
+        matches!(self, Self::Primary) || self.selects(freq_mhz)
+    }
+
+    fn validate(self, center_mhz: u32, channel_freqs: &[u32]) -> Result<(), String> {
+        match self {
+            Self::Primary if !channel_freqs.iter().any(|&freq| self.selects(freq)) => Err(
+                "--coded-scan requires an exact FFT bin at 2402, 2426, or 2480 MHz; adjust --center-freq or --channels"
+                    .to_string(),
+            ),
+            Self::Secondary(freq)
+                if !(2404..=2478).contains(&freq) || freq % 2 != 0
+                    || is_primary_advertising_frequency(freq) =>
+            {
+                Err("--coded-scan-frequency-mhz requires an even BLE data-channel center".to_string())
+            }
+            Self::Secondary(freq)
+                if freq.abs_diff(center_mhz) as usize >= channel_freqs.len() / 2
+                    || !channel_freqs.contains(&freq) =>
+            {
+                Err("--coded-scan-frequency-mhz requires an interior FFT bin".to_string())
+            }
+            _ => Ok(()),
+        }
+    }
 }
 
