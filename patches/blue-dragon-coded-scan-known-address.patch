     #[test]
+    fn continuous_coded_scan_checks_exact_connected_address_and_crc() {
+        // Access address and CRC initialization from Core Vol 6 Part C's
+        // data-channel sample. Use nonempty ACL data without CTEInfo.
+        let aa = 0xaa08_192b;
+        let crc_init = 0xc4c181;
+        let frequency = 2444;
+        let channel = freq_to_channel(frequency);
+        let pdu = [0x16, 5, 1, 2, 3, 4, 5];
+        let timestamp = Timespec { tv_sec: 0, tv_nsec: 0 };
+        assert!((aa ^ BLE_ADV_AA).count_ones() > BLE_MAX_HD);
+
+        for ci in [0, 1] {
+            let mut demod = vec![0.0; 512];
+            demod.extend(coded_scan_fixture_on_channel(&pdu, ci, aa, crc_init, channel, true));
+            demod.extend(std::iter::repeat_n(0.0, 256));
+
+            let packets =
+                ble_coded_scan_packets(&demod, frequency, timestamp.clone(), &mut |address| {
+                    (address == aa).then_some((crc_init, true))
+                });
+            assert_eq!(packets.len(), 1);
+            let packet = &packets[0];
+            assert_eq!(packet.aa, aa);
+            assert!(packet.is_data && packet.conn_valid && packet.crc_checked && packet.crc_valid);
+            assert_eq!(packet.data[4], ci);
+            assert_eq!(&packet.data[5..5 + pdu.len()], &pdu);
+            assert_eq!(&packet.data[5 + pdu.len()..], &[0x45, 0xd0, 0xd2]);
+
+            for context in [None, Some((crc_init ^ 1, true)), Some((crc_init, false))] {
+                let packets =
+                    ble_coded_scan_packets(&demod, frequency, timestamp.clone(), &mut |address| {
+                        (address == aa).then_some(context).flatten()
+                    });
+                assert!(packets.is_empty(), "accepted unverified context {context:?}");
+            }
+
+            for check_crc in [false, true] {
+                let ordinary = ble_coded_burst(
+                    &demod,
+                    frequency,
+                    timestamp.clone(),
+                    BLE_SPS,
+                    check_crc,
+                    |address| (address == aa).then_some((crc_init, true)),
+                );
+                assert!(ordinary.is_none_or(|packet| !packet.is_data));
+            }
+
+            let mut truncated = vec![0.0; 512];
+            truncated.extend(coded_scan_fixture_on_channel(
+                &pdu, ci, aa, crc_init, channel, true,
+            ));
+            let coding_s = if ci == 0 { 8 } else { 2 };
+            truncated.truncate(truncated.len() - 3 * coding_s * BLE_SPS);
+            let packets =
+                ble_coded_scan_packets(&truncated, frequency, timestamp.clone(), &mut |address| {
+                    (address == aa).then_some((crc_init, true))
+                });
+            assert!(packets.is_empty(), "accepted truncated packet without TERM2 extent");
+
+            let mut corrupt = vec![0.0; 512];
+            corrupt.extend(coded_scan_fixture_on_channel(
+                &pdu, ci, aa, crc_init, channel, false,
+            ));
+            let packets =
+                ble_coded_scan_packets(&corrupt, frequency, timestamp.clone(), &mut |address| {
+                    (address == aa).then_some((crc_init, true))
+                });
+            assert!(
+                packets.is_empty(),
+                "accepted corrupt packet with a known address"
+            );
+        }
+    }
