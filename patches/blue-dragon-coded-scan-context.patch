+struct ScanConnection {
+    aa: u32,
+    crc_init: Option<u32>,
+    started_ns: u128,
+    completed_ns: u128,
+    expires_ns: u128,
+}
+
+/// CRC initialization observed in one file replay. Keep only the latest
+/// request per access address and evict the oldest at the connection limit.
+/// A request authorizes CRC validation through its declared supervision
+/// timeout. Data decodes and overlapping copies do not renew that interval.
+#[derive(Default)]
+pub struct CodedScanConnections {
+    latest: Vec<ScanConnection>,
+}
+
+impl CodedScanConnections {
+    /// Resolve an address only after its request completed in the recording.
+    pub fn crc_init_at(&self, aa: u32, preamble: &Timespec) -> Option<(u32, bool)> {
+        let at = timespec_ns(preamble);
+        let entry = self.latest.iter().find(|entry| entry.aa == aa)?;
+        if at <= entry.completed_ns || at > entry.expires_ns {
+            return None;
+        }
+        entry.crc_init.map(|crc_init| (crc_init, true))
+    }
+
+    /// Observe a completed non-periodic connection request with a verified CRC.
+    /// Use the containing burst's bounds when the exact packet bounds are unknown.
+    pub fn observe_request(&mut self, packet: &BlePacket, completed: &Timespec) {
+        let Some((aa, crc_init, timeout_ns)) = scan_request(packet) else {
+            return;
+        };
+        let started_ns = timespec_ns(&packet.timestamp);
+        let completed_ns = timespec_ns(completed);
+        if completed_ns <= started_ns {
+            return;
+        }
+        let incoming = ScanConnection {
+            aa,
+            crc_init: Some(crc_init),
+            started_ns,
+            completed_ns,
+            expires_ns: completed_ns + timeout_ns,
+        };
+
+        if let Some(entry) = self.latest.iter_mut().find(|entry| entry.aa == aa) {
+            if started_ns > entry.completed_ns {
+                *entry = incoming;
+            } else if completed_ns >= entry.started_ns && entry.crc_init != incoming.crc_init {
+                // Overlap with conflicting seeds prevents an unambiguous order.
+                entry.crc_init = None;
+                entry.started_ns = entry.started_ns.max(started_ns);
+                entry.completed_ns = entry.completed_ns.max(completed_ns);
+            }
+        } else if self.latest.len() < BLE_MAX_CONNECTIONS {
+            self.latest.push(incoming);
+        } else if let Some(oldest) = self.latest.iter_mut().min_by_key(|entry| entry.started_ns) {
+            if started_ns > oldest.started_ns {
+                *oldest = incoming;
+            }
+        }
+    }
+}
+
+fn timespec_ns(timestamp: &Timespec) -> u128 {
+    u128::from(timestamp.tv_sec) * 1_000_000_000 + u128::from(timestamp.tv_nsec)
+}
+
+fn scan_request(packet: &BlePacket) -> Option<(u32, u32, u128)> {
+    if packet.aa != BLE_ADV_AA
+        || !packet.crc_checked
+        || !packet.crc_valid
+        || packet.len != packet.data.len()
+    {
+        return None;
+    }
+    let offset = match packet.phy {
+        BlePhy::PhyCoded => {
+            if !(2404..=2478).contains(&packet.freq)
+                || packet.freq % 2 != 0
+                || packet.freq == 2426
+                || !matches!(packet.data.get(4), Some(0 | 1))
+            {
+                return None;
+            }
+            5
+        }
+        BlePhy::Phy1M | BlePhy::Phy2M => 4,
+    };
+    if u32::from_le_bytes(packet.data.get(..4)?.try_into().ok()?) != BLE_ADV_AA {
+        return None;
+    }
+    // Core 6.2, Vol 6, Part B sections 2.3.3.1 and 3.1.1 describe the
+    // request payload and advertising CRC initialization.
+    let body = packet.data.get(offset..)?;
+    if body.len() != 39 || body[0] & 0x0F != 5 || body[1] != 34 {
+        return None;
+    }
+    let (pdu, crc) = body.split_at(36);
+    if crc24(pdu, 0x555555).to_le_bytes()[..3] != *crc {
+        return None;
+    }
+    let aa = u32::from_le_bytes(pdu[14..18].try_into().ok()?);
+    let crc_init = u32::from_le_bytes([pdu[18], pdu[19], pdu[20], 0]);
+    let timeout = u16::from_le_bytes(pdu[28..30].try_into().ok()?);
+    if aa == BLE_ADV_AA || !(10..=3200).contains(&timeout) {
+        return None;
+    }
+    Some((aa, crc_init, u128::from(timeout) * 10_000_000))
+}
