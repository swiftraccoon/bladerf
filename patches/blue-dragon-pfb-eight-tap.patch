+    #[cfg(target_arch = "x86_64")]
+    #[test]
+    fn eight_tap_avx2_preserves_wrapping_dot_products() {
+        if !is_x86_feature_detected!("avx2") {
+            return;
+        }
+
+        let extremes = [i16::MIN, i16::MAX, 0, -1, 1, -2048, 2047, 107];
+        let mixed = std::array::from_fn::<_, 24, _>(|index| extremes[index % extremes.len()]);
+        let negative = [i16::MIN; 24];
+        let positive = [i16::MAX; 24];
+        let wrapping_dot = |samples: &[i16], coefficients: &[i16]| {
+            samples
+                .iter()
+                .zip(coefficients)
+                .map(|(&sample, &coefficient)| i64::from(sample) * i64::from(coefficient))
+                .sum::<i64>() as i32
+        };
+
+        for coefficients in [&negative, &positive, &mixed] {
+            for offset in 0..16 {
+                let real = &negative[offset..offset + 8];
+                let imag = &mixed[offset..offset + 8];
+                let coefficients = &coefficients[offset..offset + 8];
+                let expected = (
+                    wrapping_dot(real, coefficients),
+                    wrapping_dot(imag, coefficients),
+                );
+                // SAFETY: AVX2 was checked above and each slice contains eight values.
+                let actual = unsafe {
+                    dotprod_avx2::<true>(real.as_ptr(), imag.as_ptr(), coefficients.as_ptr(), 8)
+                };
+                assert_eq!(actual, expected, "tap offset {offset}");
+            }
+        }
+    }
